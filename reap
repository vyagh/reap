def under_proj(d):
    """A project dir must be a real directory sitting directly inside PROJ, reject a
    symlink pointing out of the tree, so reap can never read/delete through it."""
    rp = os.path.realpath(d)
    return os.path.isdir(rp) and os.path.dirname(rp) == os.path.realpath(PROJ)

def dirname_for(path):
    """Claude Code's own cwd->project-dir mapping: every non-alnum char becomes '-'
    (not just '/': a dot or underscore in the path needs this too, e.g. 'my.app')."""
    return re.sub(r"[^a-zA-Z0-9]", "-", path)

def dir_by_cwd(cwd):
    """Claude Code caps a long dir name and appends a hash we can't reproduce, so
    find the project whose transcripts recorded this cwd in their header."""
    for d in sorted(glob.glob(os.path.join(PROJ, "*"))):
        if not under_proj(d): continue
        for p in glob.glob(os.path.join(d, "*.jsonl")):
            c = meta(p)[2]
            if c is not None:
                if c == cwd: return d
                break
    return None

def resolve_dir(arg):
    if not arg:
        cwd = os.path.abspath(os.getcwd())
        d = os.path.join(PROJ, dirname_for(cwd))
        return d if os.path.isdir(d) else dir_by_cwd(cwd) or d
    if os.path.isdir(arg):
        ap = os.path.abspath(arg)
        return ap if os.path.dirname(ap) == PROJ else os.path.join(PROJ, dirname_for(ap))
    cands = sorted(d for d in glob.glob(os.path.join(PROJ, "*"))
                   if under_proj(d) and arg in os.path.basename(d))
    if len(cands) > 1:                                    # tie-break: prefer an exact leaf match
        exact = [d for d in cands if os.path.basename(d).endswith(arg)]
        if len(exact) == 1: cands = exact
    if len(cands) == 1: return cands[0]
    if not cands: sys.exit(f"no project folder matches '{arg}'")
    sys.exit("ambiguous '%s':\n  %s" % (arg, "\n  ".join(os.path.basename(c) for c in cands)))

def pretty(DIR):
    name = os.path.basename(DIR)
    prefix = dirname_for(HOME)   # e.g. -home-alice
    if name == prefix: return "~"
    if name.startswith(prefix): name = name[len(prefix):]
    return name.lstrip("-") or os.path.basename(DIR)

_CTRL = {c: None for c in range(0x20)}; _CTRL[0x7f] = None
def clean(s):
    """Strip C0 control chars (ESC/BEL/…) so transcript text can't inject terminal
    escape sequences when printed. Whitespace is already normalized by the caller."""
    return s.translate(_CTRL)

def read_json(path, tries=3):
    """Read JSON, retrying briefly: roster/session files can be caught mid-write,
    and a silent miss here would drop a live session's protection."""
    for i in range(tries):
        try:
            with open(path) as fh: return json.load(fh)
        except FileNotFoundError: return None
        except (ValueError, OSError):
            if i + 1 < tries: time.sleep(0.03)
    return None

def load_state():
    """Read-only: never creates the file, a malformed one reads as empty."""
    o = read_json(STATE_PATH)
    if not isinstance(o, dict): return {"keep": {}}
    keep = o.get("keep")
    st = {"keep": keep if isinstance(keep, dict) else {}}
    if isinstance(o.get("pin"), str): st["pin"] = o["pin"]
    return st

def id_on_disk(cid):
    """A keep entry is only worth remembering while the chat, or its trash entry,
    still exists somewhere. Checked live, never against a loaded-in-memory list."""
    if glob.glob(os.path.join(PROJ, "*", cid + ".jsonl")): return True
    if codex_rollout_glob(cid): return True
    for d in glob.glob(os.path.join(TRASH, "*")):
        m = read_json(os.path.join(d, "reap-meta.json"))
        if isinstance(m, dict) and m.get("uuid") == cid: return True
    return False

def write_state(state):
    """Prune + write atomically. Only called for a keep/trash action or
    `rm --apply`, never on a read-only run."""
    keep = {k: v for k, v in state.get("keep", {}).items() if id_on_disk(k)}
    state = {"keep": keep, **({"pin": state["pin"]} if "pin" in state else {})}
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_PATH + f".tmp{os.getpid()}"
    with open(tmp, "w") as fh: json.dump(state, fh)
    os.replace(tmp, STATE_PATH)
    return state

def days_left(at, now):
    return max(0, TRASH_DAYS - int((now - at) / 86400))

def own_pid_domain():
    """Claude Code's pidDomain for this host: 'linux:<machine-id>:pid:[<ns inode>]',
    with an empty part where one can't be read. Every other platform writes the
    bare string 'linux', so a session from there still compares equal."""
    if sys.platform != "linux": return "linux"
    try:
        with open("/etc/machine-id") as fh: mid = fh.read().strip()
    except OSError: mid = ""
    try: ns = os.readlink("/proc/self/ns/pid")
    except OSError: ns = ""
    return f"linux:{mid}:{ns}"

def proc_dead(pid, domain=None):
    """True only when we can positively confirm the pid is gone: an exited session.
    Anything uncertain (no pid, permission error) stays 'alive' so the guard errs safe.
    `domain` is the session's pidDomain: a pid from another machine or namespace
    (synced ~/.claude, container, sandbox) means nothing here, so such a session
    is never judged dead."""
    if not isinstance(pid, int): return False
    own = own_pid_domain()
    if domain and str(domain).strip() != own: return False
    try: os.kill(pid, 0)
    except ProcessLookupError: return True
    except Exception: pass
    return False

def live_session_ids():
    # A session/worker whose pid is dead is a stale file, not a live session. Don't protect it.
    ids = set()
    for p in glob.glob(os.path.join(CLAUDE_HOME, "sessions", "*.json")):
        o = read_json(p)
        if isinstance(o, dict) and not proc_dead(o.get("pid"), o.get("pidDomain")): ids.add(o.get("sessionId"))
    r = read_json(os.path.join(CLAUDE_HOME, "daemon", "roster.json"))
    if isinstance(r, dict):
        for w in r.get("workers", {}).values():
            if isinstance(w, dict) and not proc_dead(w.get("pid"), w.get("pidDomain")): ids.add(w.get("sessionId"))
    return {i for i in ids if i}

def dirsize(p):
    t = 0
    for root, _, files in os.walk(p):
        for f in files:
            try: t += os.path.getsize(os.path.join(root, f))
            except OSError: pass
    return t

def human(n):
    n = float(n)
    for u in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.1f}{u}" if (u in "MG" and n < 10) else f"{n:.0f}{u}"
        n /= 1024
    return f"{n:.0f}T"

def reltime(mt, now):
    d = max(0, now - mt)
    if d < 3600: return f"{int(d // 60)}m"
    if d < 86400: return f"{int(d // 3600)}h"
    if d < 86400 * 30: return f"{int(d // 86400)}d"
    return f"{int(d // (86400 * 30))}mo"

def meta(path):
    # Only title (custom-title/agent-name) and the first user prompt are needed,
    # and they live in the header. json.loads is the launch hotspot, so cheaply
    # reject lines that can't carry either before parsing: title and prompt stay
    # byte-identical to a full parse. n counts your prompts by substring, a user
    # record that isn't a tool result or a meta line. Assistant records can't be
    # counted this way (one record per content block), so they're left out.
    title = prompt = cwd = None
    n = 0
    try:
        with open(path) as fh:
            for line in fh:
                if '"type":"user"' in line and '"tool_result"' not in line and '"isMeta":true' not in line:
                    n += 1
                is_title = '"custom-title"' in line or '"agent-name"' in line or '"ai-title"' in line
                want_cwd = cwd is None and '"cwd"' in line   # real path, ~1 extra parse per file
                if not is_title and not want_cwd and (prompt is not None or '"type":"user"' not in line):
                    continue
                try: o = json.loads(line)
                except Exception: continue
                if cwd is None and o.get("cwd"): cwd = o["cwd"]
                t = o.get("type")
                if t == "custom-title" and o.get("customTitle"): title = clean(o["customTitle"])
                elif t == "agent-name" and o.get("agentName") and not title: title = clean(o["agentName"])
                elif t == "ai-title" and o.get("aiTitle") and not title: title = clean(o["aiTitle"])
                elif prompt is None and t == "user" and not o.get("isMeta"):
                    c = o.get("message", {}).get("content")
                    if isinstance(c, list):
                        c = " ".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
                    if isinstance(c, str):
                        c = c.strip()
                        if c and not c.startswith(("<local-command", "<command-", "Caveat:")):
                            prompt = clean(" ".join(c.split()))
    except OSError: pass
    return title, prompt, cwd, n

def peek_turns(path, cap=250, text_only=False, src="claude"):
    """Read a transcript into a list of (who, text) message turns. Read-only.
    text_only skips tool calls/results: a clean human/assistant read for the preview."""
    if src == "codex": return peek_turns_codex(path, cap)
    out = []
    try:
        with open(path) as fh:
            for line in fh:
                try: o = json.loads(line)
                except Exception: continue
                if o.get("type") not in ("user", "assistant") or o.get("isMeta"): continue
                c = o.get("message", {}).get("content")
                parts = []
                if isinstance(c, str):
                    parts = [c]
                elif isinstance(c, list):
                    for b in c:
                        if not isinstance(b, dict): continue
                        if b.get("type") == "text": parts.append(b.get("text", ""))
                        elif text_only: continue
                        elif b.get("type") == "tool_use": parts.append(f"[tool: {b.get('name', '?')}]")
                        elif b.get("type") == "tool_result": parts.append("[tool result]")
                text = " ".join(s for s in parts if s).strip()
                if not text or text.startswith(("<local-command", "<command-", "Caveat:")): continue
                out.append(("you" if o["type"] == "user" else "claude", clean(" ".join(text.split()))))
                if len(out) >= cap: break
    except OSError: pass
    return out

def peek_turns_codex(path, cap=250):
    """Same shape as peek_turns, read from a Codex rollout: response_item message
    records, role user -> you, role assistant -> codex."""
    out = []
    try:
        with open(path) as fh:
            for line in fh:
                try: o = json.loads(line)
                except Exception: continue
                if o.get("type") != "response_item": continue
                p = o.get("payload") or {}
                if p.get("type") != "message" or p.get("role") not in ("user", "assistant"): continue
                parts = [b.get("text", "") for b in p.get("content", [])
                         if isinstance(b, dict) and b.get("type") in ("input_text", "output_text", "text")]
                text = " ".join(s for s in parts if s).strip()
                if not text: continue
                if p["role"] == "user" and text.startswith(SKIP_PREFIXES): continue
                out.append(("you" if p["role"] == "user" else "codex", clean(" ".join(text.split()))))
                if len(out) >= cap: break
    except OSError: pass
    return out

def codex_meta(path):
    """First line only: a session_meta record. None if that's not what it is."""
    try:
        with open(path) as fh: line = fh.readline()
    except OSError: return None
    try: o = json.loads(line)
    except Exception: return None
    if o.get("type") != "session_meta": return None
    p = o.get("payload") or {}
    if not p.get("id"): return None
    return {"id": p["id"], "cwd": p.get("cwd"), "thread_source": p.get("thread_source")}

def codex_last_cwd(path, tail=65536):
    """Folder of the newest turn: codex resumes a chat where it was last used, which
    can differ from the session_meta cwd. Reads only the file's tail."""
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, os.path.getsize(path) - tail))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError: return None
    for line in reversed(lines):
        if '"type":"turn_context"' not in line: continue
        try: return (json.loads(line).get("payload") or {}).get("cwd")
        except Exception: continue
    return None

def codex_scan(path, cap=400):
    """(title_or_None, msgs) from the first non-skipped user prompts, capped at `cap` lines."""
    title = None; n = 0
    try:
        with open(path) as fh:
            for i, line in enumerate(fh):
                if i >= cap: break
                if '"role":"user"' not in line and '"role": "user"' not in line: continue
                try: o = json.loads(line)
                except Exception: continue
                if o.get("type") != "response_item": continue
                p = o.get("payload") or {}
                if p.get("role") != "user": continue
                parts = [b.get("text", "") for b in p.get("content", [])
                         if isinstance(b, dict) and b.get("type") in ("input_text", "text")]
                text = clean(" ".join(" ".join(parts).split()))
                if not text or text.startswith(SKIP_PREFIXES): continue
                n += 1
                if title is None: title = text
    except OSError: pass
    return title, n

def codex_titles():
    """id -> thread_name from session_index.jsonl, last line for an id wins."""
    titles = {}
    try:
        with open(os.path.join(CODEX_HOME, "session_index.jsonl")) as fh:
            for line in fh:
                try: o = json.loads(line)
                except Exception: continue
                if o.get("id") and o.get("thread_name"): titles[o["id"]] = o["thread_name"]
    except OSError: pass
    return titles

def codex_rollout_glob(cid):
    return glob.glob(os.path.join(CODEX_HOME, "sessions", "*", "*", "*", f"*{cid}*.jsonl"))

def codex_lock_live(cid):
    """Positive proof only: a lock file whose flock or lockf probe fails EWOULDBLOCK.
    Missing file or an unreadable one that isn't 'not found' stays protected."""
    p = os.path.join(CODEX_HOME, "thread-writer-locks", cid + ".lock")
    try: fd = os.open(p, os.O_RDWR)
    except FileNotFoundError: return False
    except OSError: return True
    live = False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB); fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError: live = True
        try:
            fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB); fcntl.lockf(fd, fcntl.LOCK_UN)
        except OSError: live = True
    finally:
        os.close(fd)
    return live

def installed(agent):
    dirs = {"claude": [PROJ],
            "codex": [os.path.join(CODEX_HOME, "sessions"), os.path.join(CODEX_HOME, "archived_sessions")]}
    return any(os.path.isdir(d) for d in dirs[agent])

def load_codex(keep, subagents=False):
    """Codex chats across every project: hidden subagent/guardian_review runs unless
    `subagents`. Grouped later by the same leaf the Claude side resolves to."""
    now = time.time(); titles = codex_titles(); out = []
    for jp in glob.glob(os.path.join(CODEX_HOME, "sessions", "*", "*", "*", "*.jsonl")):
        m = codex_meta(jp)
        if not m: continue
        if not subagents and m["thread_source"] in ("subagent", "guardian_review"): continue
        cid = m["id"]
        title = titles.get(cid); titled = bool(title)
        if not title:
            title, n = codex_scan(jp)
        else:
            _, n = codex_scan(jp)
        label = clean(title) if title else "(untitled)"
        mt = os.path.getmtime(jp); cwd = codex_last_cwd(jp) or m["cwd"]
        pdir = os.path.join(PROJ, dirname_for(cwd)) if cwd else None
        out.append({
            "uuid": cid, "short": cid.split("-")[0], "dir": pdir, "proj": pretty(pdir) if pdir else "~",
            "path": jp, "label": label, "titled": titled, "cwd": cwd, "msgs": n,
            "size": os.path.getsize(jp), "mt": mt, "rel": reltime(mt, now), "live": codex_lock_live(cid),
            "src": "codex", "kept": cid in keep,
        })
    return out

def load_claude_chats(DIR, keep):
    live = live_session_ids()
    now = time.time()
    proj = pretty(DIR)
    chats = []
    for jp in glob.glob(os.path.join(DIR, "*.jsonl")):
        uuid = os.path.basename(jp)[:-6]
        sd = os.path.join(DIR, uuid)
        fh = os.path.join(CLAUDE_HOME, "file-history", uuid)   # edit snapshots, the big leftover
        title, prompt, cwd, n = meta(jp)
        mt = os.path.getmtime(jp)
        size = os.path.getsize(jp) + (dirsize(sd) if os.path.isdir(sd) else 0)
        size += dirsize(fh) if os.path.isdir(fh) else 0
        chats.append({
            "uuid": uuid, "short": uuid.split("-")[0], "dir": DIR, "proj": proj, "path": jp,
            "label": title or prompt or "(empty)",
            "titled": bool(title),                       # else the label is just its first message
            "cwd": cwd,                                  # real path, so headers aren't dash-mangled
            "msgs": n, "size": size,
            "mt": mt, "rel": reltime(mt, now), "live": uuid in live,
            "src": "claude", "kept": uuid in keep,
        })
    return chats

def load_chats(DIR, subagents=False):
    keep = load_state()["keep"]
    chats = load_claude_chats(DIR, keep)
    chats += [c for c in load_codex(keep, subagents) if c["dir"] == DIR]
    chats.sort(key=lambda c: c["mt"], reverse=True)
    return chats

def load_all(tmp=False, subagents=False):
    """Ephemeral /tmp scratchpad sessions (macOS: /private/tmp) are hidden by default:
    nothing you'd want to keep lives there, and their uuid-laden paths swamp the group headers."""
    keep = load_state()["keep"]
    chats = []
    for d in sorted(glob.glob(os.path.join(PROJ, "*"))):
        if not under_proj(d): continue
        if not tmp and os.path.basename(d).startswith(("-tmp-", "-private-tmp-")): continue
        chats += load_claude_chats(d, keep)
    chats += load_codex(keep, subagents)
    recent = {}
    for c in chats:
        recent[c["proj"]] = max(recent.get(c["proj"], 0), c["mt"])
    chats.sort(key=lambda c: (-recent[c["proj"]], c["proj"], -c["mt"]))  # group by folder, recent first
    return chats

def resumer_job_dirs(uuid):
    """Job dirs whose resumeSessionId is this chat: they'd dangle after delete."""
    out = []
    for d in glob.glob(os.path.join(CLAUDE_HOME, "jobs", "*")):
        try:
            with open(os.path.join(d, "state.json")) as fh: txt = fh.read()
        except OSError: continue
        if uuid not in txt: continue                     # cheap reject before json.loads
        try:
            if json.loads(txt).get("resumeSessionId") == uuid: out.append(d)
        except Exception: pass
    return out

def chat_artifacts(DIR, uuid):
    arts = [os.path.join(DIR, uuid + ".jsonl"), os.path.join(DIR, uuid)]
    for sub in ("file-history", "session-env", "tasks"):   # per-session state keyed by uuid
        arts.append(os.path.join(CLAUDE_HOME, sub, uuid))
    short = uuid.split("-")[0]                            # empty short would collapse to the whole
    if short: arts.append(os.path.join(CLAUDE_HOME, "jobs", short))   # jobs/ dir, guard it
    return arts + resumer_job_dirs(uuid)

def artifact_kinds(DIR, uuid):
    """What a delete would actually move, for the dry-run line: only what is on disk."""
    kinds = []
    for p in chat_artifacts(DIR, uuid):
        if not os.path.exists(p): continue
        k = ("transcript" if p.endswith(".jsonl") else "sidecar" if p == os.path.join(DIR, uuid)
             else os.path.basename(os.path.dirname(p)))
        if k not in kinds: kinds.append(k)
    return kinds

def delete_chat(DIR, uuid):                              # hard, irreversible
    for p in chat_artifacts(DIR, uuid):
        if os.path.isdir(p): shutil.rmtree(p, ignore_errors=True)
        elif os.path.exists(p): os.remove(p)

def trash_move(key, paths, label="", origin="", cwd=None):
    """Soft-delete: move paths into a trash entry with a restore manifest. Reversible."""
    dest = os.path.join(TRASH, f"{int(time.time() * 1000)}-{key}")
    os.makedirs(dest, exist_ok=True)
    moved = []
    for src in paths:
        if not os.path.exists(src): continue
        base = os.path.basename(src)
        if os.path.exists(os.path.join(dest, base)):      # e.g. sidecar and file-history/session-env/tasks all named <uuid>
            base = os.path.basename(os.path.dirname(src)) + "." + base
        try:
            shutil.move(src, os.path.join(dest, base))
            moved.append([src, base])
        except (OSError, shutil.Error): pass
    with open(os.path.join(dest, "reap-meta.json"), "w") as fh:
        json.dump({"uuid": key, "dir": origin, "label": label, "at": time.time(), "moved": moved,
                   "proj": pretty(origin) if origin else "~", "cwd": cwd}, fh)
    return dest

def trash_chat(DIR, uuid, label="", cwd=None):
    return trash_move(uuid, chat_artifacts(DIR, uuid), label, DIR, cwd)

def run_codex(args):
    """Every codex call: stdin from /dev/null, output captured, 30s timeout. A timeout
    counts as failure. Returns (ok, first line of stderr/stdout)."""
    try:
        r = subprocess.run(["codex"] + args, stdin=subprocess.DEVNULL,
                            capture_output=True, text=True, timeout=30)
        lines = (r.stderr or r.stdout or "").strip().splitlines()
        return r.returncode == 0, (lines[0] if lines else "")
    except FileNotFoundError:
        return False, "codex not found on PATH"
    except subprocess.TimeoutExpired:
        return False, "timed out"

def trash_codex(cid, label, no_cli, proj, cwd):
    """reap never moves a Codex chat's own files: state_5.sqlite's threads.rollout_path
    would dangle. Shell to `codex archive`, whose own archived_sessions holds the file;
    the entry holds no files, just where to find it. --no-codex-cli falls back to
    moving the rollout file into reap's own trash, like a Claude chat."""
    dest = os.path.join(TRASH, f"{int(time.time() * 1000)}-{cid}")
    if no_cli:
        os.makedirs(dest, exist_ok=True)
        moved = []
        for src in codex_rollout_glob(cid):
            base = os.path.basename(src)
            try:
                shutil.move(src, os.path.join(dest, base)); moved.append([src, base])
            except (OSError, shutil.Error): pass
        with open(os.path.join(dest, "reap-meta.json"), "w") as fh:
            json.dump({"uuid": cid, "dir": "", "label": label, "at": time.time(),
                       "moved": moved, "src": "codex", "archived": None, "proj": proj, "cwd": cwd}, fh)
        return dest, None
    ok, err = run_codex(["archive", cid])
    if not ok: return None, f"codex archive failed: {err}"
    os.makedirs(dest, exist_ok=True)
    archived = next(iter(glob.glob(os.path.join(CODEX_HOME, "archived_sessions", f"*{cid}*.jsonl"))), None)
    with open(os.path.join(dest, "reap-meta.json"), "w") as fh:
        json.dump({"uuid": cid, "dir": "", "label": label, "at": time.time(),
                   "moved": [], "src": "codex", "archived": archived, "proj": proj, "cwd": cwd}, fh)
    return dest, None

def restore_codex(meta, d, no_cli):
    if meta.get("moved"):                                 # --no-codex-cli fallback entry
        for src, base in meta["moved"]:
            s = os.path.join(d, base)
            if os.path.exists(s) and not os.path.exists(src):
                os.makedirs(os.path.dirname(src), exist_ok=True)
                try: shutil.move(s, src)
                except (OSError, shutil.Error): pass
        shutil.rmtree(d, ignore_errors=True)
        return meta
    ok, _ = run_codex(["unarchive", meta.get("uuid", "")])
    if not ok: return None                                # entry stays, so the user can retry
    shutil.rmtree(d, ignore_errors=True)
    return meta

def purge_entry(m, no_cli):
    """Purge (trash 'x', 'E', the 7-day prune): permanent, so the entry always drops."""
    if m.get("src") == "codex" and not m.get("moved") and not no_cli:
        run_codex(["delete", m.get("uuid", ""), "--force"])
    shutil.rmtree(m["_dir"], ignore_errors=True)

def restore_entry(d):
    """Move a trash entry's artifacts back to their original paths; drop the entry.
    Validates the (possibly tampered) manifest: base must be a bare name inside the entry,
    and src must land back under a directory reap owns, never an arbitrary path."""
    roots = (os.path.realpath(PROJ),) + tuple(
        os.path.realpath(os.path.join(CLAUDE_HOME, sub))
        for sub in ("jobs", "file-history", "session-env", "tasks"))
    meta = read_json(os.path.join(d, "reap-meta.json"))
    if not isinstance(meta, dict): return None
    if meta.get("src") == "codex":
        return restore_codex(meta, d, NO_CODEX_CLI)
    for src, base in meta.get("moved", []):
        if not isinstance(src, str) or base != os.path.basename(base): continue
        rp = os.path.realpath(src)
        if not any(rp == r or rp.startswith(r + os.sep) for r in roots): continue
        s = os.path.join(d, base)
        if os.path.exists(s) and not os.path.exists(src):
            os.makedirs(os.path.dirname(src), exist_ok=True)
            try: shutil.move(s, src)
            except (OSError, shutil.Error): pass
    shutil.rmtree(d, ignore_errors=True)
    return meta

def dir_cwd(d):
    """The cwd a project dir's first readable transcript recorded, else None."""
    for p in glob.glob(os.path.join(d, "*.jsonl")):
        c = meta(p)[2]
        if c is not None: return c
    return None

def trash_list():
    """Trash entries newest-first, each meta annotated with _dir, _size and _proj. A Codex
    entry with no moved files shows the archived file's size, read live. Entries from
    before the manifest carried a project get one from dir, else '~', and the cwd from the
    trashed transcript's header, else from one still in that dir, so the band reads like the list's."""
    out = []
    for d in glob.glob(os.path.join(TRASH, "*")):
        if not os.path.isdir(d): continue
        m = read_json(os.path.join(d, "reap-meta.json"))
        if not isinstance(m, dict): continue
        m["_dir"] = d
        m["_proj"] = m.get("proj") or (pretty(m["dir"]) if m.get("dir") else "~")
        if not m.get("cwd"):
            tp = trash_transcript(m)
            m["cwd"] = (meta(tp)[2] if os.path.isfile(tp) else None) or (dir_cwd(m["dir"]) if m.get("dir") else None)
        if m.get("src") == "codex" and not m.get("moved"):
            arch = m.get("archived")
            m["_size"] = os.path.getsize(arch) if arch and os.path.exists(arch) else 0
        else:
            m["_size"] = dirsize(d)
        out.append(m)
    out.sort(key=lambda m: m.get("at", 0), reverse=True)
    return out

def trash_stat():
    """(count, bytes): walks the trash, so call on change, never per frame."""
    ents = trash_list()
    return len(ents), sum(e["_size"] for e in ents)

def trash_transcript(m):
    """Where a trash entry's transcript lives: Codex's own archive for an entry that
    moved nothing, else the .jsonl moved into the entry dir. '' when there is none."""
    if m.get("src") == "codex" and not m.get("moved"): return m.get("archived") or ""
    return next((os.path.join(m["_dir"], os.path.basename(b)) for _, b in m.get("moved") or []
                 if b.endswith(".jsonl")), "")

def trash_chats():
    """Trash entries shaped as chat dicts, so the list's renderer draws them. The age
    counts from the deletion, and a purge can act on the dict as it is the manifest."""
    now = time.time(); out = []
    for m in trash_list():
        at = m.get("at", 0)
        out.append(dict(m, uuid=m.get("uuid", ""), label=m.get("label") or "(empty)", proj=m["_proj"],
                        cwd=m.get("cwd"), size=m["_size"], mt=at, rel=reltime(at, now),
                        src=m.get("src", "claude"), live=False, kept=False, _left=days_left(at, now),
                        titled=bool(m.get("label")), path=trash_transcript(m), msgs=None))
    recent = {}
    for c in out:
        recent[c["proj"]] = max(recent.get(c["proj"], 0), c["mt"])
    out.sort(key=lambda c: (-recent[c["proj"]], c["proj"], -c["mt"]))
    return out

def prune_trash(days=TRASH_DAYS, no_cli=False):
    """Lazy retention: drop entries older than `days`. Runs once at launch, no daemon, ~ms."""
    if not os.path.isdir(TRASH): return
    cutoff = time.time() - days * 86400
    for d in glob.glob(os.path.join(TRASH, "*")):
        m = read_json(os.path.join(d, "reap-meta.json"))
        if isinstance(m, dict): at = m.get("at", 0)
        else:
            try: at = os.path.getmtime(d)
            except OSError: continue
        if at < cutoff:
            if isinstance(m, dict):
                m["_dir"] = d; purge_entry(m, no_cli)
            else: shutil.rmtree(d, ignore_errors=True)

def projlabel(p, wdt):
    return p if len(p) <= wdt else "…" + p[-(wdt - 1):]

def plural(n, w="chat"):
    return f"{n} {w}" + ("" if n == 1 else "s")

def split_path(cwd, fallback):
    """(leaf, parent) from a real cwd: the leaf is what you actually call the project."""
    if not cwd: return fallback, ""
    p = ("~" + cwd[len(HOME):]) if cwd.startswith(HOME) else cwd
    p = p.rstrip("/")
    leaf = os.path.basename(p)
    return (leaf or p), (os.path.dirname(p) if leaf else "")

def fit(s, width):
    if width <= 0: return ""
    return s if len(s) <= width else s[:max(0, width - 1)] + "…"

def order(chats, mode, grouped):
    """Recency keeps loader order; size sorts big-first (within each group when grouped)."""
    if mode != "size": return chats
    if grouped:
        tot = {}
        for c in chats: tot[c["proj"]] = tot.get(c["proj"], 0) + c["size"]
        return sorted(chats, key=lambda c: (-tot[c["proj"]], c["proj"], -c["size"]))
    return sorted(chats, key=lambda c: -c["size"])

def group_of(items, i):
    """Index of the group header governing row i (nearest 'hdr' at or before i), or None."""
    for j in range(min(i, len(items) - 1), -1, -1):
        if items[j][0] == "hdr": return j
    return None

def plan_view(items, cur, top, avail, grouped):
    """Scroll math + sticky header. Returns (top, pinned_hdr_idx_or_None, body_rows)."""
    if not items: return 0, None, avail
    cur = max(0, min(cur, len(items) - 1))
    top = min(top, cur)
    if cur >= top + avail: top = cur - avail + 1
    top = max(0, top)
    gh = group_of(items, cur) if grouped else None
    if gh is not None and gh < top:                       # real header scrolled off -> pin it
        body = max(1, avail - 1)
        if cur >= top + body: top = cur - body + 1
        return max(0, top), gh, body
    return top, None, avail

def print_static(chats, grouped=False):
    last = None
    for c in chats:
        if grouped and c["proj"] != last:
            last = c["proj"]; print(f"\n# {c['proj']}")
        src = "  codex" if c.get("src") == "codex" else ""
        live = "  * live" if c["live"] else ""
        print(f"  {c['rel']:>4} {human(c['size']):>6} {c['msgs']:>5}  {c['label'][:44]:44} {c['short']}{src}{live}")
    print(f"\n{len(chats)} chats - {human(sum(c['size'] for c in chats))} total")

def selftest_trash():
    """A trash entry written before the manifest carried proj and cwd still lists."""
    global TRASH
    old = {"uuid": "0a", "dir": os.path.join(PROJ, dirname_for(HOME + "/app")), "label": "old", "at": 1,
           "moved": [["/gone/0a.jsonl", "0a.jsonl"]]}
    new = dict(old, uuid="0b", label="new", proj="app", cwd=HOME + "/app")
    home = dict(old, uuid="0c", dir=os.path.join(PROJ, dirname_for(HOME)))
    deep = dict(old, uuid="0d", label="deep", dir=os.path.join(PROJ, dirname_for(HOME + "/work/deep-app")),
                moved=[["/gone/0d.jsonl", "0d.jsonl"]])
    real, TRASH = TRASH, tempfile.mkdtemp()
    try:
        for m in (old, new, home, deep):
            os.makedirs(os.path.join(TRASH, m["uuid"]))
            with open(os.path.join(TRASH, m["uuid"], "reap-meta.json"), "w") as fh: json.dump(m, fh)
        with open(os.path.join(TRASH, "0d", "0d.jsonl"), "w") as fh:
            fh.write(json.dumps({"type": "user", "cwd": HOME + "/work/deep-app"}) + "\n")
        got = {e["uuid"]: e["_proj"] for e in trash_list()}
        shaped = trash_chats()
    finally:
        shutil.rmtree(TRASH, ignore_errors=True); TRASH = real
    assert got == {"0a": "app", "0b": "app", "0c": "~", "0d": "work-deep-app"}, got
    assert {c["label"] for c in shaped} == {"old", "new", "deep"}, shaped
    assert {c["proj"] for c in shaped} == {"app", "~", "work-deep-app"}, shaped
    assert [split_path(c["cwd"], c["proj"])[0] for c in shaped if c["label"] == "deep"] == ["deep-app"], shaped
    assert {os.path.basename(c["path"]) for c in shaped if c["label"] == "old"} == {"0a.jsonl"}, shaped
    print("trash   : old and new manifests list under", got["0a"], "and", got["0c"])

def selftest(chats, where):
    print(f"loaded {len(chats)} chats from {where}")
    print("live    :", [c["short"] for c in chats if c["live"]] or "none")
    print("projects:", dict(Counter(c["proj"] for c in chats)))
    print("src     :", dict(Counter(c.get("src", "claude") for c in chats)))
    if chats:
        t = peek_turns(chats[0]["path"], src=chats[0].get("src", "claude"))
        print(f"peek({chats[0]['short']}): {len(t)} turns, first =", (t[0] if t else "none"))
    print_static(chats[:6], grouped=True)
    selftest_trash()

def term_light():
    """True/False from the terminal's OSC 11 background reply, None when it won't say."""
    import select, termios, tty
    try:
        fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        return None
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        # a local terminal answers in a few ms; give up fast so a silent one costs
        # nothing you'd notice. read byte-wise so typeahead after the reply stays unread
        os.write(fd, b"\033]11;?\033\\")
        buf = b""
        end = time.time() + 0.15
        while not buf.endswith((b"\033\\", b"\a")):
            if not select.select([fd], [], [], max(0, end - time.time()))[0]: break
            buf += os.read(fd, 1)
    except (OSError, termios.error):
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old); os.close(fd)
    m = re.search(rb"rgb:([0-9a-f]+)/([0-9a-f]+)/([0-9a-f]+)", buf, re.I)
    if not m: return None
    r, g, b = (int(x, 16) * 255 // (16 ** len(x) - 1) for x in m.groups())
    return r * 299 + g * 587 + b * 114 >= 128000

def run_ui(loader, title, grouped):
    import curses, locale
    locale.setlocale(locale.LC_ALL, "")
    light = term_light() if sys.stdin.isatty() and sys.stdout.isatty() else None

    def main(stdscr, loader=loader, grouped=grouped, trashing=False):
        curses.curs_set(0)
        curses.use_default_colors()
        try:                                             # no mouse support is not an error
            curses.mousemask(curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED
                             | curses.BUTTON4_PRESSED | getattr(curses, "BUTTON5_PRESSED", 0))
            curses.mouseinterval(0)                      # report the press itself, not a click
        except curses.error:
            pass

        def pair(i, fg, bg=-1):
            try:
                curses.init_pair(i, fg, bg); return curses.color_pair(i)
            except Exception:
                return 0
        if curses.COLORS >= 256:
            # muted xterm-256 palette, picked to stay legible on BOTH light and dark terminals.
            # A_DIM renders inconsistently across emulators; a real grey is predictable.
            LIVE = pair(5, 71)
            OK = LIVE | curses.A_BOLD
            YEL = pair(6, 136)
            DANGER = pair(7, 131) | curses.A_BOLD
            ACC = pair(8, 67)
            DIM = pair(9, 245)
            # explicit fg AND bg, so the cursor row looks right whatever the theme
            SEL = pair(10, 231, 60) | curses.A_BOLD
            tab_attr = (pair(11, 231, 67) or curses.A_REVERSE) | curses.A_BOLD
            band = None if light is None else 254 if light else 236
            BANDT = pair(12, -1, band) if band else 0
            BANDD = pair(13, 245, band) if band else 0
            tint = None if light is None else 189 if light else 18
            TINT = pair(14, -1, tint) if tint else 0
            TINTLIVE = pair(15, 71, tint) if tint else 0
            TINTACC = pair(18, 67, tint) | curses.A_BOLD if tint else 0
            tray = None if light is None else 255 if light else 235
            TRAYD = pair(16, 245, tray) if tray else 0
            TRAYLIVE = pair(17, 71, tray) if tray else 0
            TRAYACC = pair(19, 67, tray) | curses.A_BOLD if tray else 0
        else:
            band = tray = None
            LIVE = pair(5, curses.COLOR_GREEN)
            OK = LIVE | curses.A_BOLD
            YEL = pair(6, curses.COLOR_YELLOW)
            DANGER = pair(7, curses.COLOR_RED) | curses.A_BOLD
            ACC = pair(8, curses.COLOR_CYAN)
            DIM = curses.A_DIM
            SEL = curses.A_REVERSE | curses.A_BOLD
            tab_attr = pair(11, curses.COLOR_BLACK, curses.COLOR_CYAN) or curses.A_REVERSE
        WARN = YEL | curses.A_BOLD

        keep_map = load_state()["keep"]                  # uuid -> epoch kept, refreshed on reload
        show_kept = False                                # resets to hidden on every launch

        chats = loader()
        by = {c["uuid"]: c for c in chats}
        picked, cur, top, flt, filtering, msg, sort_mode = set(), 0, 0, "", False, None, "recency"
        undo = []                                        # this session's deletes, one list of trash dirs each
        tn, tb = trash_stat()                            # cached; refreshed only on change
        folded = set()                                   # collapsed project groups
        focus = None                                     # uuid the cursor should land on after a view change
        changed = False                                  # a trash pass altered the trash
        restored = []                                    # trash chats put back, in order
        tip = False                                      # show the pin tip until the next key that isn't a tab switch
        pcache = {}                                       # uuid -> preview turns (lazy, cached)

        def tab_list(chats):
            """Installed agents (data dir present, even at 0 chats), in registration
            order, preceded by 'all' once there's more than one. A single-agent machine gets
            no tabs at all."""
            agent_counts = Counter(c.get("src", "claude") for c in chats)
            tabs = [a for a in AGENTS if installed(a) or agent_counts.get(a)]
            return (["all"] + tabs) if len(tabs) > 1 else tabs, agent_counts

        tabs, agent_counts = tab_list(chats)
        pinned = load_state().get("pin")
        tab = (pinned if pinned in tabs else "all") if len(tabs) > 1 else None

        def switch_tab(t):
            nonlocal tab, cur, top, tip
            tab = t
            cur = top = 0; tip = True

        def reload():                                    # after any trash-mutating action
            nonlocal chats, by, tn, tb, keep_map, tabs, agent_counts, tab
            keep_map = load_state()["keep"]
            chats = loader(); by = {c["uuid"]: c for c in chats}
            tn, tb = trash_stat()
            tabs, agent_counts = tab_list(chats)
            if tab not in tabs: tab = "all" if len(tabs) > 1 else None

        def add(y, x, s, attr=0):
            h, w = stdscr.getmaxyx()
            if not (0 <= y < h) or x < 0: return
            try: stdscr.addstr(y, x, s[:max(0, w - 1 - x)], attr)
            except curses.error: pass

        def edge(y, ch, attr=0, col=None):               # add() clips the last column, so write direct
            h, w = stdscr.getmaxyx()
            x = (w - 1) if col is None else min(col, w - 1)
            if 0 <= y < h - 1:
                try: stdscr.addstr(y, x, ch, attr)
                except curses.error: pass

        def box(y0, x0, hh, ww, ttl="", tattr=curses.A_BOLD):
            add(y0, x0, "┌" + RULE * (ww - 2) + "┐", DIM)
            for yy in range(y0 + 1, y0 + hh - 1):
                add(yy, x0, "│" + " " * (ww - 2), DIM); add(yy, x0 + ww - 1, "│", DIM)
            add(y0 + hh - 1, x0, "└" + RULE * (ww - 2) + "┘", DIM)
            if ttl: add(y0, x0 + 2, f" {ttl} ", tattr)

        def scrollbar(y0, page, off, n, col=None):
            if n <= page or page < 2: return
            for j in range(page): edge(y0 + j, "│", DIM, col)
            edge(y0 + int((page - 1) * off / (n - page)), "┃", ACC | curses.A_BOLD, col)

        def do_help():
            h, w = stdscr.getmaxyx()
            ww = min(74, w - 2); hh = min(len(HELP_LINES) + 4, h)
            y0, x0 = max(0, (h - hh) // 2), max(0, (w - ww) // 2)
            box(y0, x0, hh, ww, "reap · keys")
            for j, (tag, s) in enumerate(HELP_LINES[:hh - 4]):
                add(y0 + 2 + j, x0 + 3, s, ACC | curses.A_BOLD if tag == "H" else DIM if tag == "D" else 0)
            add(y0 + hh - 2, x0 + 3, "any key to close", DIM)
            stdscr.refresh(); stdscr.getch()

        def do_peek(c):                                  # read-only transcript preview
            turns = peek_turns(c["path"], src=c.get("src", "claude"))
            lines = []
            w0 = stdscr.getmaxyx()[1]
            for who, text in turns:
                lines.append(("u" if who == "you" else "a", BAR + " " + who))
                for ln in (textwrap.wrap(text, max(10, w0 - 6)) or [""]):
                    lines.append(("", "   " + ln))
                lines.append(("", ""))
            if not lines: lines = [("", "(no readable messages)")]
            off = 0
            while True:
                stdscr.erase()
                h, w = stdscr.getmaxyx()
                page = max(1, h - 4)
                off = max(0, min(off, max(0, len(lines) - page)))
                pct = 100 if len(lines) <= page else int(100 * (off + page) / len(lines))
                add(0, 1, "peek", curses.A_BOLD)
                add(0, 6, fit(c["label"], w - 28), ACC | curses.A_BOLD)
                pos = f"{len(turns)} turns · {pct}%"
                add(0, max(1, w - len(pos) - 2), pos, DIM)
                add(1, 0, RULE * (w - 1), DIM)
                for j, (tag, s) in enumerate(lines[off:off + page]):
                    add(2 + j, 1, s, OK if tag == "u" else ACC | curses.A_BOLD if tag == "a" else 0)
                scrollbar(2, page, off, len(lines))
                add(h - 2, 0, RULE * (w - 1), DIM)
                add(h - 1, 1, "↑/↓ scroll · g/G ends · q back", DIM)
                stdscr.refresh()
                k = stdscr.getch()
                if k in (ord("q"), 27, ord("p")): return
                elif k in (curses.KEY_DOWN, ord("j")): off += 1
                elif k in (curses.KEY_UP, ord("k")): off -= 1
                elif k == curses.KEY_NPAGE: off += page
                elif k == curses.KEY_PPAGE: off -= page
                elif k == ord("g"): off = 0
                elif k == ord("G"): off = len(lines)

        def confirm_ask(prompt, hint, tattr=DANGER):
            h, w = stdscr.getmaxyx()
            ww = min(max(len(prompt) + 6, len(hint) + 6, 44), w - 2)
            y0, x0 = max(0, h // 2 - 2), max(0, (w - ww) // 2)
            box(y0, x0, 5, ww, prompt, tattr)
            add(y0 + 2, x0 + 3, "y", tattr); add(y0 + 2, x0 + 5, hint, DIM)
            stdscr.refresh()
            return stdscr.getch() in (ord("y"), ord("Y"))

        def confirm_delete(sel, purge=False):
            sel = sorted(sel, key=lambda c: -c["size"])
            freed = human(sum(c["size"] for c in sel))
            h, w = stdscr.getmaxyx()
            shown = min(len(sel), 8, max(1, h - 8))
            more = len(sel) - shown
            ww = min(max(50, w * 2 // 3), w - 2)
            hh = shown + (1 if more else 0) + 5
            y0, x0 = max(0, (h - hh) // 2), max(0, (w - ww) // 2)
            n = len(sel)
            box(y0, x0, hh, ww, f"{'purge' if purge else 'delete'} {plural(n)} · {freed}",
                DANGER if purge else curses.A_BOLD)
            for j in range(shown):
                c = sel[j]
                src = c.get("src", "claude")
                extra = len(src) + 2 if src != "claude" else 0
                add(y0 + 2 + j, x0 + 3, f"{human(c['size']):>6}", DIM)
                add(y0 + 2 + j, x0 + 11, fit(c["label"], ww - 14 - extra))
                if extra: add(y0 + 2 + j, x0 + ww - 2 - len(src), src, DIM)
            if more: add(y0 + 2 + shown, x0 + 11, f"… and {more} more", DIM)
            add(y0 + hh - 2, x0 + 3, "y", DANGER if purge else OK)
            other_src = sorted({c.get("src", "claude") for c in sel} - {"claude"})
            if purge:
                hint = "gone for good · " + ("codex chats via codex delete · " if other_src else "") + "other key cancels"
            elif other_src:
                hint = f"move to trash · {', '.join(other_src)} chats via codex archive · undo for {TRASH_DAYS}d"
            else:
                hint = f"move to trash · undo for {TRASH_DAYS}d · other key cancels"
            add(y0 + hh - 2, x0 + 5, hint, DIM)
            stdscr.refresh()
            return stdscr.getch() in (ord("y"), ord("Y"))

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            tab_chats = chats if tab in (None, "all") else [c for c in chats if c.get("src", "claude") == tab]
            ordered = order(tab_chats, sort_mode, grouped)
            f = flt.lower()
            vis = ordered if not flt else [c for c in ordered
                                           if f in c["label"].lower() or f in c["uuid"] or f in c["proj"].lower()]
            all_vis = vis                                # keeps hidden chats: a project can be all-hidden, . needs the nearest
            if not show_kept: vis = [c for c in vis if not c["kept"]]

            items = []                                   # gap + header + chat rows
            if grouped:
                stat, cwds = {}, {}
                for c in all_vis:
                    s = stat.setdefault(c["proj"], [0, 0]); s[0] += 1; s[1] += c["size"]
                    if c.get("cwd"): cwds.setdefault(c["proj"], c["cwd"])
                hidden = Counter(c["proj"] for c in all_vis if c["kept"])
                last = None
                for c in all_vis:
                    if c["proj"] != last:
                        if last is not None: items.append(("gap",))   # blank line between sections
                        last = c["proj"]
                        items.append(("hdr", c["proj"], stat.get(c["proj"], (0, 0)), cwds.get(c["proj"])))
                        if c["proj"] in folded: continue
                        grp = [x for x in vis if x["proj"] == last]
                        gone = [x for x in grp if x["kept"]]
                        items += [("chat", x) for x in grp if not x["kept"]]
                        if gone: items += [("label", "hidden")] + [("chat", x) for x in gone]
            else:
                items = [("chat", c) for c in vis if not c["kept"]]
                gone = [c for c in vis if c["kept"]]
                if gone: items += [("label", "hidden")] + [("chat", c) for c in gone]

            if focus:
                at = [i for i, it in enumerate(items) if it[0] == "chat" and it[1]["uuid"] == focus]
                if at: cur = at[0]
                focus = None

            # a folded header is navigable, so you can still reach and reopen it
            ci = [i for i, it in enumerate(items)
                  if it[0] == "chat" or (it[0] == "hdr" and it[1] in folded)]
            if not ci:
                cur = 0
            elif cur >= len(items) or items[cur][0] != "chat":
                later = [i for i in ci if i >= cur]
                cur = later[0] if later else ci[-1]

            top, pin, body = plan_view(items, cur, top, max(1, h - 4), grouped)

            total = sum(c["size"] for c in tab_chats)
            psz = sum(by[u]["size"] for u in picked if u in by)
            # split the terminal: a readable list on the left, a detail pane on the right when wide
            pane = w >= LIST_W + PANE_MIN
            cw = LIST_W if pane else w - 1               # list content width
            px = cw + 3                                  # detail-pane left column
            rw = w - 1                                   # rules span the whole frame
            all_tabs = grouped and len(tabs) > 1         # the tab bar takes the badge's place
            if trashing: add(0, 1, " trash ", SEL)
            elif not all_tabs: add(0, 1, " reap ", SEL)
            kept_count = sum(1 for c in tab_chats if c["kept"])
            filtered = flt and not filtering
            right = []
            if picked: right.append((f"{len(picked)} picked · {human(psz)}", ACC))
            if trashing:
                right += [(plural(len(tab_chats)), DIM), (human(total), DIM)]
            elif filtered:
                shown_n = sum(1 for c in tab_chats if show_kept or not c["kept"])
                right.append((f"{len(vis)} of {plural(shown_n)}", DIM))
            else:
                if kept_count: right.append((f"{kept_count} hidden", DIM))
                if tn: right.append((f"trash {human(tb)}", YEL))
            if len(tabs) > 1 and not trashing: right.append((title if not grouped else human(total), DIM))
            rtxt = "   ".join(t for t, _ in right)
            x_right = max(8, cw - len(rtxt))
            x = x_right
            for j, (t, attr) in enumerate(right):
                if j: add(0, x, "   ", DIM); x += 3
                add(0, x, t, attr); x += len(t)

            badge = ("  /" + flt if flt and not filtering else "") + ("  ▼ size" if sort_mode == "size" else "")
            tab_spans = []                               # (x0, x1, tab) per drawn tab, for clicks
            if len(tabs) > 1:
                x = 9 if trashing else 1 if all_tabs else 8
                for a in tabs:
                    n = len(chats) if a == "all" else agent_counts.get(a, 0)
                    ttxt = f" {'*' if a == pinned else ''}{a} {n} "
                    add(0, x, ttxt, tab_attr if a == tab else DIM)
                    if a == pinned: add(0, x + 1, "*", (tab_attr | curses.A_BOLD) if a == tab else ACC)
                    tab_spans.append((x, x + len(ttxt), a)); x += len(ttxt) + 1
                if badge: add(0, x, badge, ACC | curses.A_BOLD); x += len(badge)
                if tip and not pinned and x + 2 + len(TAB_TIP) < x_right:
                    add(0, x + 2, TAB_TIP, DIM)
            elif not trashing:
                avail = max(0, x_right - 3 - 8)
                total_txt = f" · {human(total)}"
                scope = projlabel(title, max(8, avail - len(total_txt) - len(badge)))
                left = scope + total_txt
                if len(left) + len(badge) > avail:
                    left = projlabel(title, max(8, avail - len(badge)))
                add(0, 8, left, DIM)
                if badge: add(0, 8 + len(left), badge, ACC | curses.A_BOLD)
            add(1, 0, RULE * rw, DIM)

            def draw_hdr(y, it, sel=False):
                shut = it[1] in folded
                leaf, _ = split_path(it[3] if len(it) > 3 else None,
                                     projlabel(it[1], PROJ_MAX))
                info = f"{plural(it[2][0])} · {human(it[2][1])}"
                if sel and not band:                     # cursor is parked on a folded group
                    add(y, 0, f" ▸ {leaf}  {info}".ljust(cw), SEL)
                    return
                add(y, 1, "▸" if shut else BAR, ACC | curses.A_BOLD)
                if band:
                    bt, bd = (TINT, TINT) if sel else (BANDT, BANDD)
                    add(y, 2, " " * (cw - 2), bt)
                    add(y, 3, leaf, bt | curses.A_BOLD)
                    if shut:
                        add(y, 3 + len(leaf) + 2, info, bd)
                        return
                    n = hidden.get(it[1], 0)
                    sz = human(it[2][1])
                    tail = f" · {sz}" if n else sz
                    add(y, cw - len(tail) - 1, tail, bd)
                    if n: add(y, cw - len(tail) - len(f"{n} hidden") - 1, f"{n} hidden", bt)
                    return
                add(y, 3, leaf, curses.A_BOLD)
                if shut:
                    add(y, 3 + len(leaf) + 2, info, DIM)
                    return
                sz = human(it[2][1])
                n = hidden.get(it[1], 0)
                tail = f" · {sz}" if n else sz
                txt = f"{n} hidden{tail}" if n else sz
                add(y, cw - len(tail), tail, DIM)
                if n: add(y, cw - len(txt), f"{n} hidden", 0)
                rule = cw - len(txt) - 2 - (3 + len(leaf) + 2)
                if rule > 0: add(y, 3 + len(leaf) + 2, RULE * rule, DIM)

            def draw_detail(it):
                pw = w - px - 1
                if pw < 20: return
                def kv(yy, k, v, vattr=0):
                    add(yy, px, k, DIM)
                    lines = textwrap.wrap(str(v), max(4, pw - 11)) or [""]
                    for i, ln in enumerate(lines): add(yy + i, px + 11, ln, vattr)
                    return yy + len(lines)
                if it[0] == "hdr":                        # cursor parked on a folded group
                    leaf, parent = split_path(it[3] if len(it) > 3 else None, it[1])
                    add(2, px, fit(leaf, pw), ACC | curses.A_BOLD)
                    yy = kv(4, "path", (parent + "/" + leaf) if parent else leaf)
                    yy = kv(yy, "chats", str(it[2][0]))
                    yy = kv(yy, "size", human(it[2][1]))
                    add(yy + 1, px, "folded · z to open", DIM); return
                c = it[1]
                add(2, px, fit(c["label"] if c["titled"] else "untitled", pw),
                    curses.A_BOLD if c["titled"] else DIM)
                leaf, parent = split_path(c["cwd"], "")
                full = (parent + "/" + leaf) if parent else leaf
                if full: add(3, px, fit(full, pw), DIM)
                state = None
                if c["kept"]:
                    kd = time.strftime("%b %d", time.localtime(keep_map.get(c["uuid"], 0)))
                    state = (f"hidden {kd} · h brings it back", DIM)
                elif c["live"]:
                    state = ("running now", LIVE)
                elif trashing:
                    state = (f"deleted {time.strftime('%b %d', time.localtime(c['mt']))}", DIM)
                src = c.get("src", "claude")
                add(4, px, src, DIM)
                if state:
                    txt, attr = state
                    add(4, px + len(src), " · ", DIM)
                    add(4, px + len(src) + 3, fit(txt, max(0, pw - len(src) - 3)), attr)
                if trashing:
                    lx = px + len(src) + 3 + len(state[0])
                    add(4, lx, " · ", DIM)
                    add(4, lx + 3, f"{c['_left']}d left", YEL if c["_left"] <= 1 else DIM)
                if trashing and c["msgs"] is None:       # header parse, once per entry
                    c["msgs"] = codex_scan(c["path"])[1] if src == "codex" else meta(c["path"])[3]
                when = time.strftime("%b %d, %H:%M", time.localtime(c["mt"]))
                bits = f"{human(c['size'])} · {plural(c['msgs'], 'prompt')}" + ("" if trashing else f" · {when}")
                add(5, px, fit(bits, pw), DIM)
                add(6, px, RULE * pw, DIM)
                turns = pcache.get(c["uuid"])            # lazy + cached: smooth to hold j
                if turns is None:
                    turns = pcache[c["uuid"]] = peek_turns(c["path"], cap=16, text_only=True, src=c.get("src", "claude"))
                ty = 8
                if not turns: add(ty, px, "(no readable messages)", DIM)
                for who, text in turns:
                    if ty >= h - 3: break
                    add(ty, px, BAR + " " + who, OK if who == "you" else ACC | curses.A_BOLD)
                    ty += 1
                    for ln in (textwrap.wrap(text, pw - 2) or [""])[:5]:
                        if ty >= h - 3: break
                        add(ty, px + 2, ln, DIM); ty += 1
                    ty += 1

            if not vis:
                if trashing: add(3, 3, "trash is empty, nothing deleted in the last 7 days", DIM)
                else: add(2, 1, "no chats" + (f" matching /{flt}" if flt else ""), DIM)
            base = 2
            row_at = {}                                  # screen row -> item index, for clicks
            if pin is not None:
                draw_hdr(base, items[pin]); row_at[base] = pin; base += 1
            for k in range(body):
                idx = top + k
                if idx >= len(items): break
                it = items[idx]; y = base + k
                row_at[y] = idx
                if it[0] == "gap":
                    continue
                if it[0] == "hdr":
                    draw_hdr(y, it, sel=(idx == cur)); continue
                if it[0] == "label":
                    lx = 3 if grouped else 1
                    tx = lx + 14                             # title column, after mark + rel + size
                    add(y, lx, (RULE * (tx - lx - 1) + f" {it[1]} ").ljust(cw - lx, RULE), DIM)
                    continue
                c = it[1]
                on = c["uuid"] in picked
                if c["live"]: mark, mattr = "●", LIVE
                elif on: mark, mattr = "◉", ACC | curses.A_BOLD
                else: mark, mattr = "·", DIM
                ind = "  " if grouped else ""
                tail = f"{c['_left']}d left" if trashing else ""
                tail_x = cw - len(tail) - 1              # the tail ends at the band's right edge
                lend = tail_x - 2 if tail else cw        # titles stop two columns before it
                if idx == cur and band:
                    x = 1 + len(ind)
                    add(y, x, " " * (cw - x), TINT)
                    add(y, x, mark, TINTLIVE if c["live"] else TINTACC if on else TINT); x += 1
                    seg = f" {c['rel']:>3} {human(c['size']):>6}  "
                    add(y, x, seg, TINT); x += len(seg)
                    lbl = fit(c["label"], max(0, min(LABEL_MAX, lend - x)))
                    add(y, x, lbl, TINT | curses.A_BOLD)
                    if tail: add(y, tail_x, tail, TINT)
                    continue
                if idx == cur:
                    pre = f" {ind}{mark} {c['rel']:>3} {human(c['size']):>6}  "
                    lbl = fit(c["label"], max(0, min(LABEL_MAX, lend - len(pre))))
                    add(y, 0, (pre + lbl).ljust(cw), SEL)
                    if tail: add(y, tail_x, tail, SEL)
                    continue
                add(y, 0, " " + ind); x = 1 + len(ind)
                dim = DIM
                if tray and c["kept"]:
                    add(y, x, " " * (cw - x), TRAYD)
                    dim = TRAYD
                    mattr = TRAYLIVE if c["live"] else TRAYACC if on else TRAYD
                add(y, x, mark, mattr); x += 1
                seg = f" {c['rel']:>3} "
                add(y, x, seg, dim); x += len(seg)
                sz = f"{human(c['size']):>6}"
                add(y, x, sz, dim); x += len(sz) + 2
                tattr = dim if c["kept"] else 0
                lbl = fit(c["label"], max(0, min(LABEL_MAX, lend - x)))
                p = lbl.lower().find(f) if flt else -1
                if p >= 0:                               # underline the filter match
                    add(y, x, lbl[:p], tattr)
                    add(y, x + p, lbl[p:p + len(f)], tattr | curses.A_BOLD | curses.A_UNDERLINE)
                    add(y, x + p + len(f), lbl[p + len(f):], tattr)
                else:
                    add(y, x, lbl, tattr)
                if tail: add(y, tail_x, tail, YEL if c["_left"] <= 1 else dim)
            if pane:                                     # divider (doubles as scroll track) + detail
                for j in range(body): add(2 + j, cw + 1, "│", DIM)
                if 0 <= cur < len(items) and items[cur][0] in ("chat", "hdr"):
                    draw_detail(items[cur])
            scrollbar(base, body, top, len(items), cw + 1 if pane else cw)

            add(h - 2, 0, RULE * rw, DIM)
            if filtering:
                add(h - 1, 1, "/", ACC | curses.A_BOLD)
                add(h - 1, 2, flt, curses.A_BOLD)
                add(h - 1, 2 + len(flt), "▏", DIM)
                mtxt = f"{len(vis)} match{'es' if len(vis) != 1 else ''} · enter apply · esc clear"
                add(h - 1, max(1, w - len(mtxt) - 1), mtxt, DIM)
            elif msg:
                add(h - 1, 1, msg[1], OK if msg[0] == "ok" else WARN)
            else:
                x = 1
                hints = [("?", "keys")]
                if len(tabs) > 1: hints += [("tab", "agents")]
                if trashing:
                    if vis: hints += [("space", "pick"), ("r", "restore"), ("x", "purge"), ("E", "empty"), ("p", "peek")]
                    hints += [("/", "filter"), ("q", "back")]
                else:
                    hints += [("s", "sort"), ("space", "pick"), ("p", "peek"), ("d", "delete")]
                    if undo: hints.append(("u", "undo"))
                    hints += [("h", "hide"), (".", "hide again" if show_kept else "show hidden"),
                              ("t", "trash"), ("/", "filter"), ("q", "quit")]
                for key, act in hints:
                    add(h - 1, x, key, curses.A_BOLD); x += len(key) + 1
                    add(h - 1, x, act, DIM); x += len(act) + 3
            stdscr.refresh()

            ch = stdscr.getch()
            msg = None
            tip = False
            if filtering:
                if ch in (10, 13): filtering = False
                elif ch == 27: filtering = False; flt = ""
                elif ch in (curses.KEY_BACKSPACE, 127, 8): flt = flt[:-1]
                elif 32 <= ch < 127: flt += chr(ch)
                cur = top = 0
                continue

            pos = ci.index(cur) if cur in ci else 0
            if ch == 27:                                 # a late terminal reply starts with ESC too
                stdscr.nodelay(True); tail = stdscr.getch()
                while tail != -1 and stdscr.getch() != -1: pass
                stdscr.nodelay(False)
                if tail != -1: continue
            if ch in (ord("q"), 27) or (trashing and ch == ord("t")): break
            elif ch == ord("?"): do_help()
            elif trashing and ch in (ord("d"), ord("u"), ord("h"), ord("."), ord("s"), 10, 13): pass
            elif trashing and ch in (ord("r"), ord("x"), ord("E")):
                sel = [by[u] for u in picked if u in by]
                if ch == ord("r"):
                    sel = sel or ([items[cur][1]] if ci and items[cur][0] == "chat" else [])
                    failed = []
                    for e in sel:
                        if restore_entry(e["_dir"]): restored.append(e)
                        else: failed.append(e)
                    if failed:
                        msg = ("warn", "could not restore " + (fit(failed[0]["label"], 40) if len(failed) == 1
                                                               else plural(len(failed))))
                    elif sel: msg = ("ok", f"restored {plural(len(sel))}")
                elif ch == ord("x"):
                    if not sel: msg = ("warn", "nothing selected")
                    elif confirm_delete(sel, purge=True):
                        for e in sel: purge_entry(e, NO_CODEX_CLI)
                        msg = ("ok", f"purged {plural(len(sel))}")
                    else: msg = ("warn", "cancelled"); sel = []
                else:
                    sel = []
                    shown = vis if flt else tab_chats
                    if shown:
                        freed = human(sum(e["size"] for e in shown))
                        scope = [] if tab in (None, "all") else [tab]
                        head = [f"empty {len(shown)} shown"] if flt else ["empty trash"]
                        tail = [freed] if flt else [plural(len(shown)), freed]
                        if confirm_ask(" · ".join(head + scope + tail),
                                       "frees the disk · gone for good · other cancels"):
                            sel = shown
                            for e in sel: purge_entry(e, NO_CODEX_CLI)
                            msg = ("ok", f"emptied {plural(len(sel))} · {freed}")
                        else: msg = ("warn", "cancelled")
                if sel: changed = True; picked = set(); reload()
            elif ci and ch in (curses.KEY_DOWN, ord("j")): cur = ci[min(pos + 1, len(ci) - 1)]
            elif ci and ch in (curses.KEY_UP, ord("k")): cur = ci[max(pos - 1, 0)]
            elif ci and ch == curses.KEY_NPAGE: cur = ci[min(pos + body, len(ci) - 1)]
            elif ci and ch == curses.KEY_PPAGE: cur = ci[max(pos - body, 0)]
            elif ci and ch == ord("g"): cur = ci[0]
            elif ci and ch == ord("G"): cur = ci[-1]
            elif ch == ord("s"):
                sort_mode = "size" if sort_mode == "recency" else "recency"
                cur = top = 0
            elif len(tabs) > 1 and ch in (9, curses.KEY_BTAB):   # tab / shift-tab: cycle
                switch_tab(tabs[(tabs.index(tab) + (1 if ch == 9 else -1)) % len(tabs)])
            elif len(tabs) > 1 and ch == ord("P"):
                st = load_state()
                if tab == "all" or tab == pinned:
                    st.pop("pin", None); pinned = None
                    msg = ("ok", "reap opens on the all tab again")
                else:
                    st["pin"] = pinned = tab
                    msg = ("ok", f"reap opens on the {tab} tab from now on")
                write_state(st)
            elif ch == curses.KEY_MOUSE:
                try: _, mx, my, _, bstate = curses.getmouse()
                except curses.error: continue
                if bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                    hit = [t for x0, x1, t in tab_spans if x0 <= mx < x1]
                    if my == 0 and hit: switch_tab(hit[0])
                    elif my in row_at and mx < cw:
                        it = items[row_at[my]]
                        if it[0] == "chat": cur = row_at[my]
                        elif it[0] == "hdr":
                            folded.discard(it[1]) if it[1] in folded else folded.add(it[1])
                elif ci and bstate & curses.BUTTON4_PRESSED: cur = ci[max(pos - 3, 0)]
                elif ci and bstate & getattr(curses, "BUTTON5_PRESSED", 0): cur = ci[min(pos + 3, len(ci) - 1)]
            elif grouped and ch == ord("]"):
                hd = [i for i, it in enumerate(items) if it[0] == "hdr"]
                gh = max([i for i in hd if i <= cur], default=-1)
                nxt = [i for i in hd if i > gh]
                if nxt: cur = nxt[0] + 1
            elif grouped and ch == ord("["):
                hd = [i for i, it in enumerate(items) if it[0] == "hdr"]
                gh = max([i for i in hd if i <= cur], default=None)
                if gh is not None and cur > gh + 1: cur = gh + 1
                else:
                    prv = [i for i in hd if gh is not None and i < gh]
                    if prv: cur = prv[-1] + 1
            elif grouped and ch in (ord("z"), curses.KEY_LEFT, curses.KEY_RIGHT):
                gi = group_of(items, cur)
                if gi is not None:
                    gp = items[gi][1]
                    folded.discard(gp) if gp in folded else folded.add(gp)
            elif grouped and ch == ord("Z"):
                allp = {c["proj"] for c in vis}
                folded.clear() if folded >= allp else folded.update(allp)
                cur = top = 0
            elif ch == ord("/"): filtering = True; flt = ""
            elif ch == ord("c"): picked.clear()
            elif ch == ord("a"):                         # toggle: all shown picked -> unpick them
                sable = [c["uuid"] for c in vis if not c["live"]]
                if sable and all(u in picked for u in sable):
                    for u in sable: picked.discard(u)
                else:
                    picked.update(sable)
            elif ch == ord("p"):
                if ci and items[cur][0] == "chat": do_peek(items[cur][1])
            elif ch == ord("t"):
                edited, back = main(stdscr, trash_chats, True, True)
                pinned = load_state().get("pin")
                if edited:                               # trash changed -> refresh list + stat
                    reload()
                    undo = [g for g in ([d for d in g if os.path.isdir(d)] for g in undo) if g]
                    cur = top = 0
                if back:
                    ids = {b["uuid"] for b in back}
                    focus = next((c["uuid"] for c in order(chats, sort_mode, grouped)
                                  if c["uuid"] in ids and tab in (None, "all", c.get("src", "claude"))), None)
                    if len(back) == 1: msg = ("ok", f"restored {fit(back[0]['label'], 40)}")
                    else: msg = ("ok", f"restored {plural(len(back))}")
            elif ch == ord("u"):
                if not undo:
                    msg = ("warn", "nothing to undo")
                else:
                    back = [m for m in map(restore_entry, undo.pop()) if m]
                    reload()
                    if not back: msg = ("warn", "could not restore")
                    elif len(back) == 1: msg = ("ok", f"restored {fit(back[0].get('label') or '?', 40)}")
                    else: msg = ("ok", f"restored {plural(len(back))}")
            elif ch == ord(" "):
                if ci and items[cur][0] == "chat":
                    c = items[cur][1]
                    if c["live"]: msg = ("warn", "can't pick a live session")
                    else: picked.discard(c["uuid"]) if c["uuid"] in picked else picked.add(c["uuid"])
                    cur = ci[min(pos + 1, len(ci) - 1)]
            elif ch == ord("h"):
                st = load_state()
                if picked:
                    now_ts = time.time()
                    hidden = [u for u in picked if u in by and by[u]["kept"]]
                    if len(hidden) == len(picked):
                        for u in hidden:
                            st["keep"].pop(u, None)
                            keep_map.pop(u, None)
                            by[u]["kept"] = False
                        msg = ("ok", f"back in the list: {plural(len(hidden))}")
                    else:
                        fresh = [u for u in picked if u in by and not by[u]["kept"]]
                        for u in fresh:
                            st["keep"][u] = now_ts
                            keep_map[u] = now_ts
                            by[u]["kept"] = True
                        msg = ("ok", f"hid {plural(len(fresh))} · . shows hidden")
                    write_state(st)
                    picked = set()
                elif ci and items[cur][0] == "chat":
                    c = items[cur][1]
                    if c["kept"]:
                        st["keep"].pop(c["uuid"], None)
                        keep_map.pop(c["uuid"], None)
                        write_state(st)
                        c["kept"] = False
                        msg = ("ok", f"back in the list: {fit(c['label'], 40)}")
                    else:
                        now_ts = time.time()
                        st["keep"][c["uuid"]] = keep_map[c["uuid"]] = now_ts
                        write_state(st)
                        c["kept"] = True
                        msg = ("ok", f"hidden {fit(c['label'], 40)} · . shows hidden")
            elif ch == ord("."):
                c = items[cur][1] if ci and items[cur][0] == "chat" else None
                show_kept = not show_kept
                if c:                                    # stay on this chat, else the nearest still shown
                    home = all_vis.index(c)
                    near = sorted((x for x in all_vis if show_kept or not x["kept"]),
                                  key=lambda x: (x["proj"] != c["proj"], abs(all_vis.index(x) - home)))
                    focus = near[0]["uuid"] if near else None
                else:
                    cur = top = 0
            elif ch in (ord("d"), 10, 13):
                if not picked:
                    msg = ("warn", "nothing selected"); continue
                sel = [by[u] for u in picked if u in by]
                if confirm_delete(sel):
                    dests, fail = [], None
                    st = load_state()
                    for u in list(picked):
                        if u not in by: continue
                        c = by[u]
                        if c.get("src") == "codex":
                            dest, err = trash_codex(c["uuid"], c["label"], NO_CODEX_CLI, c["proj"], c["cwd"])
                            if err: fail = err; continue
                        else:
                            dest = trash_chat(c["dir"], u, c["label"], c["cwd"])
                        dests.append(dest); st["keep"].pop(u, None)
                    if dests: write_state(st)
                    undo.append(dests)
                    reload()
                    n = len(dests)
                    picked = set()
                    if fail: msg = ("warn", fail)
                    elif n: msg = ("ok", f"trashed {plural(n)} · u undo · t trash")
                    else: msg = ("warn", "nothing trashed")
                else:
                    msg = ("warn", "cancelled")
        return changed, restored

    curses.wrapper(main)

