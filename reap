#!/usr/bin/env python3
"""reap, Claude Code chat manager: view, peek and delete local chats.

A chat = its transcript + sidecar dir + agents-view job record. reap deletes
all three together, so a chat is gone from /resume AND the agents view.

Usage:
  reap                     interactive picker for the current project
  reap <name|path>         picker for a project (name = folder substring)
  reap --all               picker across every project, grouped by workspace
  reap ls [<name>|--all]   print a plain list (no UI; pipe-friendly)
  reap rm <id>... [opts]   delete by uuid prefix (for scripts)   opts below
  reap trash [--empty]     list recoverable deletes (or purge them all)
  reap restore <id|name>   restore a chat from the trash
  reap --help              this help

  reap rm options:  --apply  actually delete (default is a dry-run)
                   --hard   skip the trash, delete irreversibly
                   --orphans  remove leftover sidecar dirs (no transcript)
                   -p <name>  target another project (default: current dir)

Deletes are soft: chats move to a trash and stay recoverable for 7 days
(pruned lazily at launch, no background process). Undo with `u` / `reap restore`.

Picker keys (press ? inside for this list):
  up/down, j/k move   PgUp/PgDn page   g/G top/bottom   [ ] prev/next workspace
  space pick (skips live)   a toggle select-all   c clear
  p peek (read-only preview)   d / enter delete (to trash, asks to confirm)
  u undo last delete   t trash browser (restore / purge)
  s sort recency<->size   / filter (title/uuid/workspace)   ? keys   q quit
"""
import json, os, sys, glob, time, shutil, textwrap
from collections import Counter

__version__ = "0.2.0"

HOME = os.path.expanduser("~")
PROJ = os.path.join(HOME, ".claude", "projects")
LIVE_FRESH = 60   # secs: a transcript touched this recently counts as live (roster-lag backstop)
TRASH = os.path.join(HOME, ".claude", ".reap-trash")
TRASH_DAYS = 7    # soft-deleted chats are recoverable this long; pruned lazily at launch
RULE, BAR, PICK_ON, PICK_OFF = "─", "▌", "●", "·"   # UI glyphs (box-drawing over ASCII)

HELP_LINES = [
    ("H", "move"),
    ("", "  ↑/↓  j/k       line            PgUp/PgDn   page"),
    ("", "  g / G          top / bottom    [ / ]       prev / next workspace"),
    ("", ""),
    ("H", "select & act"),
    ("", "  space          toggle pick (skips live sessions)"),
    ("", "  a / c          toggle select-all shown / clear"),
    ("", "  p              peek: read-only preview"),
    ("", "  d or enter     delete selected → trash (confirms first)"),
    ("", ""),
    ("H", "trash · undo"),
    ("", "  u              undo the last delete"),
    ("", "  t              trash browser: restore / purge"),
    ("", ""),
    ("H", "view"),
    ("", "  s              sort: recency ↔ size"),
    ("", "  /              filter title · uuid · workspace"),
    ("", "  q              quit"),
    ("", ""),
    ("D", "delete moves the chat to a trash, recoverable for 7 days."),
]

def resolve_dir(arg):
    if not arg:
        return os.path.join(PROJ, os.path.abspath(os.getcwd()).replace("/", "-"))
    if os.path.isdir(arg):
        ap = os.path.abspath(arg)
        return ap if os.path.dirname(ap) == PROJ else os.path.join(PROJ, ap.replace("/", "-"))
    cands = sorted(d for d in glob.glob(os.path.join(PROJ, "*"))
                   if os.path.isdir(d) and arg in os.path.basename(d))
    if len(cands) > 1:                                    # tie-break: prefer an exact leaf match
        exact = [d for d in cands if os.path.basename(d).endswith(arg)]
        if len(exact) == 1: cands = exact
    if len(cands) == 1: return cands[0]
    if not cands: sys.exit(f"no project folder matches '{arg}'")
    sys.exit("ambiguous '%s':\n  %s" % (arg, "\n  ".join(os.path.basename(c) for c in cands)))

def pretty(DIR):
    name = os.path.basename(DIR)
    prefix = "-" + HOME.strip("/").replace("/", "-")   # e.g. -home-alice
    if name.startswith(prefix): name = name[len(prefix):]
    return name.lstrip("-") or os.path.basename(DIR)

def read_json(path, tries=3):
    """Read JSON, retrying briefly: roster/session files can be caught mid-write,
    and a silent miss here would drop a live session's protection."""
    for i in range(tries):
        try:
            with open(path) as fh: return json.load(fh)
        except FileNotFoundError: return None
        except (ValueError, OSError):
            if i + 1 < tries: time.sleep(0.03)
    return None

def live_session_ids():
    ids = set()
    for p in glob.glob(os.path.join(HOME, ".claude", "sessions", "*.json")):
        o = read_json(p)
        if isinstance(o, dict): ids.add(o.get("sessionId"))
    r = read_json(os.path.join(HOME, ".claude", "daemon", "roster.json"))
    if isinstance(r, dict):
        for w in r.get("workers", {}).values():
            if isinstance(w, dict): ids.add(w.get("sessionId"))
    return {i for i in ids if i}

def dirsize(p):
    t = 0
    for root, _, files in os.walk(p):
        for f in files:
            try: t += os.path.getsize(os.path.join(root, f))
            except OSError: pass
    return t

def human(n):
    n = float(n)
    for u in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.1f}{u}" if (u in "MG" and n < 10) else f"{n:.0f}{u}"
        n /= 1024
    return f"{n:.0f}T"

def spark(n):
    """One-glyph size scale, makes the heavy chats pop in the list."""
    for i, t in enumerate((100 << 10, 1 << 20, 3 << 20, 10 << 20, 30 << 20, 100 << 20)):
        if n < t: return "▁▂▃▄▅▆"[i]
    return "█"

def reltime(mt, now):
    d = max(0, now - mt)
    if d < 3600: return f"{int(d // 60)}m"
    if d < 86400: return f"{int(d // 3600)}h"
    if d < 86400 * 30: return f"{int(d // 86400)}d"
    return f"{int(d // (86400 * 30))}mo"

def meta(path):
    # Only title (custom-title/agent-name) and the first user prompt are needed,
    # and they live in the header. json.loads is the launch hotspot, so cheaply
    # reject lines that can't carry either before parsing: title/prompt/count
    # stay byte-identical to a full parse.
    title = prompt = None
    n = 0
    try:
        with open(path) as fh:
            for line in fh:
                n += 1
                is_title = '"custom-title"' in line or '"agent-name"' in line
                if not is_title and (prompt is not None or '"type":"user"' not in line):
                    continue
                try: o = json.loads(line)
                except Exception: continue
                t = o.get("type")
                if t == "custom-title" and o.get("customTitle"): title = o["customTitle"]
                elif t == "agent-name" and o.get("agentName") and not title: title = o["agentName"]
                elif prompt is None and t == "user" and not o.get("isMeta"):
                    c = o.get("message", {}).get("content")
                    if isinstance(c, list):
                        c = " ".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
                    if isinstance(c, str):
                        c = c.strip()
                        if c and not c.startswith(("<local-command", "<command-", "Caveat:")):
                            prompt = " ".join(c.split())
    except OSError: pass
    return title, prompt, n

def peek_turns(path, cap=250):
    """Read a transcript into a list of (who, text) message turns. Read-only."""
    out = []
    try:
        with open(path) as fh:
            for line in fh:
                try: o = json.loads(line)
                except Exception: continue
                if o.get("type") not in ("user", "assistant") or o.get("isMeta"): continue
                c = o.get("message", {}).get("content")
                parts = []
                if isinstance(c, str):
                    parts = [c]
                elif isinstance(c, list):
                    for b in c:
                        if not isinstance(b, dict): continue
                        if b.get("type") == "text": parts.append(b.get("text", ""))
                        elif b.get("type") == "tool_use": parts.append(f"[tool: {b.get('name', '?')}]")
                        elif b.get("type") == "tool_result": parts.append("[tool result]")
                text = " ".join(s for s in parts if s).strip()
                if not text or text.startswith(("<local-command", "<command-", "Caveat:")): continue
                out.append(("you" if o["type"] == "user" else "claude", " ".join(text.split())))
                if len(out) >= cap: break
    except OSError: pass
    return out

def load_chats(DIR):
    live = live_session_ids()
    now = time.time()
    proj = pretty(DIR)
    chats = []
    for jp in glob.glob(os.path.join(DIR, "*.jsonl")):
        uuid = os.path.basename(jp)[:-6]
        sd = os.path.join(DIR, uuid)
        title, prompt, n = meta(jp)
        mt = os.path.getmtime(jp)
        chats.append({
            "uuid": uuid, "short": uuid.split("-")[0], "dir": DIR, "proj": proj, "path": jp,
            "label": title or prompt or "(empty)",
            "msgs": n, "size": os.path.getsize(jp) + (dirsize(sd) if os.path.isdir(sd) else 0),
            "mt": mt, "rel": reltime(mt, now), "live": uuid in live or (now - mt) < LIVE_FRESH,
        })
    chats.sort(key=lambda c: c["mt"], reverse=True)
    return chats

def load_all():
    chats = []
    for d in sorted(glob.glob(os.path.join(PROJ, "*"))):
        if os.path.isdir(d): chats += load_chats(d)
    recent = {}
    for c in chats:
        recent[c["proj"]] = max(recent.get(c["proj"], 0), c["mt"])
    chats.sort(key=lambda c: (-recent[c["proj"]], c["proj"], -c["mt"]))  # group by folder, recent first
    return chats

def resumer_job_dirs(uuid):
    """Job dirs whose resumeSessionId is this chat: they'd dangle after delete."""
    out = []
    for d in glob.glob(os.path.join(HOME, ".claude", "jobs", "*")):
        try:
            with open(os.path.join(d, "state.json")) as fh: txt = fh.read()
        except OSError: continue
        if uuid not in txt: continue                     # cheap reject before json.loads
        try:
            if json.loads(txt).get("resumeSessionId") == uuid: out.append(d)
        except Exception: pass
    return out

def chat_artifacts(DIR, uuid):
    return [os.path.join(DIR, uuid + ".jsonl"),
            os.path.join(DIR, uuid),
            os.path.join(HOME, ".claude", "jobs", uuid.split("-")[0])] + resumer_job_dirs(uuid)

def delete_chat(DIR, uuid):                              # hard, irreversible
    for p in chat_artifacts(DIR, uuid):
        if os.path.isdir(p): shutil.rmtree(p, ignore_errors=True)
        elif os.path.exists(p): os.remove(p)

def trash_chat(DIR, uuid, label=""):
    """Soft-delete: move the chat's artifacts into the trash with a manifest. Reversible."""
    dest = os.path.join(TRASH, f"{int(time.time() * 1000)}-{uuid}")
    os.makedirs(dest, exist_ok=True)
    moved = []
    for src in chat_artifacts(DIR, uuid):
        if not os.path.exists(src): continue
        try:
            shutil.move(src, os.path.join(dest, os.path.basename(src)))
            moved.append([src, os.path.basename(src)])
        except (OSError, shutil.Error): pass
    with open(os.path.join(dest, "reap-meta.json"), "w") as fh:
        json.dump({"uuid": uuid, "dir": DIR, "label": label, "at": time.time(), "moved": moved}, fh)
    return dest

def restore_entry(d):
    """Move a trash entry's artifacts back to their original paths; drop the entry."""
    try:
        meta = json.load(open(os.path.join(d, "reap-meta.json")))
    except Exception:
        return None
    for src, base in meta.get("moved", []):
        s = os.path.join(d, base)
        if os.path.exists(s) and not os.path.exists(src):
            os.makedirs(os.path.dirname(src), exist_ok=True)
            try: shutil.move(s, src)
            except (OSError, shutil.Error): pass
    shutil.rmtree(d, ignore_errors=True)
    return meta

def trash_list():
    """Trash entries newest-first, each meta annotated with _dir and _size."""
    out = []
    for d in glob.glob(os.path.join(TRASH, "*")):
        if not os.path.isdir(d): continue
        try: m = json.load(open(os.path.join(d, "reap-meta.json")))
        except Exception: continue
        m["_dir"] = d; m["_size"] = dirsize(d)
        out.append(m)
    out.sort(key=lambda m: m.get("at", 0), reverse=True)
    return out

def prune_trash(days=TRASH_DAYS):
    """Lazy retention: drop entries older than `days`. Runs once at launch, no daemon, ~ms."""
    if not os.path.isdir(TRASH): return
    cutoff = time.time() - days * 86400
    for d in glob.glob(os.path.join(TRASH, "*")):
        try: at = json.load(open(os.path.join(d, "reap-meta.json"))).get("at", 0)
        except Exception:
            try: at = os.path.getmtime(d)
            except OSError: continue
        if at < cutoff: shutil.rmtree(d, ignore_errors=True)

def role(label):
    l = label.lower()
    if l.startswith("stale"): return "stale"
    for r in ("planner", "worker", "reviewer", "thinker"):
        if r in l: return r
    return "other"

def projlabel(p, wdt):
    return p if len(p) <= wdt else "…" + p[-(wdt - 1):]

def fit(s, width):
    if width <= 0: return ""
    return s if len(s) <= width else s[:max(0, width - 1)] + "…"

def order(chats, mode, grouped):
    """Recency keeps loader order; size sorts big-first (within each group when grouped)."""
    if mode != "size": return chats
    if grouped:
        tot = {}
        for c in chats: tot[c["proj"]] = tot.get(c["proj"], 0) + c["size"]
        return sorted(chats, key=lambda c: (-tot[c["proj"]], c["proj"], -c["size"]))
    return sorted(chats, key=lambda c: -c["size"])

def plan_view(items, cur, top, avail, grouped):
    """Scroll math + sticky header. Returns (top, pinned_hdr_idx_or_None, body_rows)."""
    if not items: return 0, None, avail
    cur = max(0, min(cur, len(items) - 1))
    top = min(top, cur)
    if cur >= top + avail: top = cur - avail + 1
    top = max(0, top)
    gh = None
    if grouped:
        for i in range(cur, -1, -1):
            if items[i][0] == "hdr": gh = i; break
    if gh is not None and gh < top:                       # real header scrolled off -> pin it
        body = max(1, avail - 1)
        if cur >= top + body: top = cur - body + 1
        return max(0, top), gh, body
    return top, None, avail

def print_static(chats, grouped=False):
    last = None
    for c in chats:
        if grouped and c["proj"] != last:
            last = c["proj"]; print(f"\n# {c['proj']}")
        live = "  * live" if c["live"] else ""
        print(f"  {c['rel']:>4} {human(c['size']):>6} {c['msgs']:>5}  {c['label'][:44]:44} {c['short']}{live}")
    print(f"\n{len(chats)} chats - {human(sum(c['size'] for c in chats))} total")

def selftest(chats, where):
    print(f"loaded {len(chats)} chats from {where}")
    print("roles   :", dict(Counter(role(c["label"]) for c in chats)))
    print("live    :", [c["short"] for c in chats if c["live"]] or "none")
    print("projects:", dict(Counter(c["proj"] for c in chats)))
    if chats:
        t = peek_turns(chats[0]["path"])
        print(f"peek({chats[0]['short']}): {len(t)} turns, first =", (t[0] if t else "none"))
    print_static(chats[:6], grouped=True)

def run_ui(loader, title, grouped):
    import curses, locale
    locale.setlocale(locale.LC_ALL, "")

    def main(stdscr):
        curses.curs_set(0)
        curses.use_default_colors()

        def pair(i, fg):
            try:
                curses.init_pair(i, fg, -1); return curses.color_pair(i)
            except Exception:
                return 0
        COL = {"planner": pair(1, curses.COLOR_CYAN), "worker": pair(2, curses.COLOR_GREEN),
               "reviewer": pair(3, curses.COLOR_YELLOW), "thinker": pair(4, curses.COLOR_MAGENTA)}
        OK = pair(5, curses.COLOR_GREEN) | curses.A_BOLD
        YEL = pair(6, curses.COLOR_YELLOW)
        WARN = YEL | curses.A_BOLD
        DANGER = pair(7, curses.COLOR_RED) | curses.A_BOLD
        ACC = pair(8, curses.COLOR_CYAN)
        SEL = curses.A_REVERSE | curses.A_BOLD          # cursor row: theme-adaptive, high-contrast
        DIM = curses.A_DIM

        chats = loader()
        by = {c["uuid"]: c for c in chats}
        picked, cur, top, flt, filtering, msg, sort_mode = set(), 0, 0, "", False, None, "recency"
        undo = []                                        # trash dirs from this session's deletes

        def add(y, x, s, attr=0):
            h, w = stdscr.getmaxyx()
            if not (0 <= y < h) or x < 0: return
            try: stdscr.addstr(y, x, s[:max(0, w - 1 - x)], attr)
            except curses.error: pass

        def edge(y, ch, attr=0):                         # write in the last column (add() clips it)
            h, w = stdscr.getmaxyx()
            if 0 <= y < h - 1:
                try: stdscr.addstr(y, w - 1, ch, attr)
                except curses.error: pass

        def box(y0, x0, hh, ww, ttl="", tattr=curses.A_BOLD):
            add(y0, x0, "┌" + RULE * (ww - 2) + "┐", DIM)
            for yy in range(y0 + 1, y0 + hh - 1):
                add(yy, x0, "│" + " " * (ww - 2), DIM); add(yy, x0 + ww - 1, "│", DIM)
            add(y0 + hh - 1, x0, "└" + RULE * (ww - 2) + "┘", DIM)
            if ttl: add(y0, x0 + 2, f" {ttl} ", tattr)

        def scrollbar(y0, page, off, n):
            if n <= page or page < 2: return
            for j in range(page): edge(y0 + j, "│", DIM)
            edge(y0 + int((page - 1) * off / (n - page)), "┃", ACC | curses.A_BOLD)

        def do_help():
            h, w = stdscr.getmaxyx()
            ww = min(74, w - 2); hh = min(len(HELP_LINES) + 4, h)
            y0, x0 = max(0, (h - hh) // 2), max(0, (w - ww) // 2)
            box(y0, x0, hh, ww, "reap · keys")
            for j, (tag, s) in enumerate(HELP_LINES[:hh - 4]):
                add(y0 + 2 + j, x0 + 3, s, ACC | curses.A_BOLD if tag == "H" else DIM if tag == "D" else 0)
            add(y0 + hh - 2, x0 + 3, "any key to close", DIM)
            stdscr.refresh(); stdscr.getch()

        def do_peek(c):                                  # read-only transcript preview
            turns = peek_turns(c["path"])
            lines = []
            w0 = stdscr.getmaxyx()[1]
            for who, text in turns:
                lines.append(("u" if who == "you" else "a", BAR + " " + who))
                for ln in (textwrap.wrap(text, max(10, min(w0 - 6, 110))) or [""]):
                    lines.append(("", "   " + ln))
                lines.append(("", ""))
            if not lines: lines = [("", "(no readable messages)")]
            off = 0
            while True:
                stdscr.erase()
                h, w = stdscr.getmaxyx()
                page = max(1, h - 4)
                off = max(0, min(off, max(0, len(lines) - page)))
                pct = 100 if len(lines) <= page else int(100 * (off + page) / len(lines))
                add(0, 1, "peek", curses.A_BOLD)
                add(0, 6, fit(c["label"], w - 28), ACC | curses.A_BOLD)
                pos = f"{len(turns)} turns · {pct}%"
                add(0, max(1, w - len(pos) - 2), pos, DIM)
                add(1, 0, RULE * (w - 1), DIM)
                for j, (tag, s) in enumerate(lines[off:off + page]):
                    add(2 + j, 1, s, OK if tag == "u" else ACC | curses.A_BOLD if tag == "a" else 0)
                scrollbar(2, page, off, len(lines))
                add(h - 2, 0, RULE * (w - 1), DIM)
                add(h - 1, 1, "↑/↓ scroll · g/G ends · q back", DIM)
                stdscr.refresh()
                k = stdscr.getch()
                if k in (ord("q"), 27, ord("p")): return
                elif k in (curses.KEY_DOWN, ord("j")): off += 1
                elif k in (curses.KEY_UP, ord("k")): off -= 1
                elif k == curses.KEY_NPAGE: off += page
                elif k == curses.KEY_PPAGE: off -= page
                elif k == ord("g"): off = 0
                elif k == ord("G"): off = len(lines)

        def confirm_ask(prompt, hint, tattr=DANGER):
            h, w = stdscr.getmaxyx()
            ww = min(max(len(prompt) + 6, len(hint) + 6, 44), w - 2)
            y0, x0 = max(0, h // 2 - 2), max(0, (w - ww) // 2)
            box(y0, x0, 5, ww, prompt, tattr)
            add(y0 + 2, x0 + 3, "y", tattr); add(y0 + 2, x0 + 5, hint, DIM)
            stdscr.refresh()
            return stdscr.getch() in (ord("y"), ord("Y"))

        def confirm_delete(sel):
            sel = sorted(sel, key=lambda c: -c["size"])
            freed = human(sum(c["size"] for c in sel))
            h, w = stdscr.getmaxyx()
            shown = min(len(sel), 8, max(1, h - 8))
            more = len(sel) - shown
            ww = min(max(50, w * 2 // 3), w - 2)
            hh = shown + (1 if more else 0) + 5
            y0, x0 = max(0, (h - hh) // 2), max(0, (w - ww) // 2)
            n = len(sel)
            box(y0, x0, hh, ww, f"delete {n} chat{'s' if n != 1 else ''} · {freed}", curses.A_BOLD)
            for j in range(shown):
                c = sel[j]
                add(y0 + 2 + j, x0 + 3, f"{human(c['size']):>6}", DIM)
                add(y0 + 2 + j, x0 + 11, fit(c["label"], ww - 14))
            if more: add(y0 + 2 + shown, x0 + 11, f"… and {more} more", DIM)
            add(y0 + hh - 2, x0 + 3, "y", OK)
            add(y0 + hh - 2, x0 + 5, f"move to trash · undo for {TRASH_DAYS}d · other key cancels", DIM)
            stdscr.refresh()
            return stdscr.getch() in (ord("y"), ord("Y"))

        def do_trash():
            sel = ch_reload = 0
            while True:
                ents = trash_list()
                stdscr.erase()
                h, w = stdscr.getmaxyx()
                add(0, 1, " trash ", curses.A_REVERSE | curses.A_BOLD)
                info = f"{len(ents)} chats · {human(sum(e['_size'] for e in ents))} · kept {TRASH_DAYS}d"
                add(0, max(1, w - len(info) - 2), info, DIM)
                add(1, 0, RULE * (w - 1), DIM)
                page = max(1, h - 4)
                if not ents: add(3, 2, "trash is empty, nothing deleted recently", DIM)
                sel = max(0, min(sel, len(ents) - 1))
                topi = max(0, min(sel - page + 1, len(ents) - page)) if len(ents) > page else 0
                for j in range(min(page, len(ents))):
                    e = ents[topi + j]; y = 2 + j
                    left = max(0, TRASH_DAYS - int((time.time() - e.get("at", 0)) / 86400))
                    row = f" {reltime(e.get('at', 0), time.time()):>4} {human(e['_size']):>6}  "
                    lbl = fit(e.get("label") or "(empty)", w - len(row) - 12)
                    if topi + j == sel:
                        add(y, 0, (row + lbl + f"   {left}d left").ljust(w - 1), SEL)
                    else:
                        add(y, 0, row, DIM); add(y, len(row), lbl)
                        add(y, len(row) + len(lbl) + 3, f"{left}d left", DIM)
                scrollbar(2, page, topi, len(ents))
                add(h - 2, 0, RULE * (w - 1), DIM)
                add(h - 1, 1, "r restore · x purge · E empty · q back", DIM)
                stdscr.refresh()
                k = stdscr.getch()
                if k in (ord("q"), ord("t"), 27): return ch_reload
                elif ents and k in (curses.KEY_DOWN, ord("j")): sel += 1
                elif ents and k in (curses.KEY_UP, ord("k")): sel = max(0, sel - 1)
                elif ents and k in (ord("r"), 10, 13):
                    restore_entry(ents[sel]["_dir"]); ch_reload = 1
                elif ents and k == ord("x"):
                    if confirm_ask("purge 1 chat permanently?", "delete forever · other cancels"):
                        shutil.rmtree(ents[sel]["_dir"], ignore_errors=True)
                elif ents and k == ord("E"):
                    if confirm_ask(f"empty trash, {len(ents)} chats, forever?", "gone for good · other cancels"):
                        for e in ents: shutil.rmtree(e["_dir"], ignore_errors=True)

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            ordered = order(chats, sort_mode, grouped)
            f = flt.lower()
            vis = ordered if not flt else [c for c in ordered
                                           if f in c["label"].lower() or f in c["uuid"] or f in c["proj"].lower()]

            items = []                                   # gap + header + chat rows
            if grouped:
                stat = {}
                for c in vis:
                    s = stat.setdefault(c["proj"], [0, 0]); s[0] += 1; s[1] += c["size"]
                last = None
                for c in vis:
                    if c["proj"] != last:
                        if last is not None: items.append(("gap",))   # blank line between sections
                        last = c["proj"]; items.append(("hdr", c["proj"], stat[c["proj"]]))
                    items.append(("chat", c))
            else:
                items = [("chat", c) for c in vis]

            ci = [i for i, it in enumerate(items) if it[0] == "chat"]
            if not ci:
                cur = 0
            elif cur >= len(items) or items[cur][0] != "chat":
                later = [i for i in ci if i >= cur]
                cur = later[0] if later else ci[-1]

            top, pin, body = plan_view(items, cur, top, max(1, h - 4), grouped)

            total = sum(c["size"] for c in chats)
            psz = sum(by[u]["size"] for u in picked if u in by)
            add(0, 1, " reap ", curses.A_REVERSE | curses.A_BOLD)
            add(0, 8, projlabel(title, w - 40), DIM)
            stats = f"{len(chats)} chats · {human(total)}"
            badge = ("  /" + flt if flt and not filtering else "") + ("  ▼ size" if sort_mode == "size" else "")
            add(0, max(1, w - len(stats) - len(badge) - 2), stats, DIM)
            if badge: add(0, max(1, w - len(badge) - 1), badge, ACC | curses.A_BOLD)
            add(1, 0, RULE * (w - 1), DIM)

            def draw_hdr(y, it):
                name = projlabel(it[1], max(8, w - 30))
                add(y, 1, BAR, ACC | curses.A_BOLD)
                add(y, 3, name, curses.A_BOLD)
                add(y, 5 + len(name), f"{it[2][0]} chats · {human(it[2][1])}", DIM)

            if not vis:
                add(2, 1, "no chats" + (f" matching /{flt}" if flt else ""), DIM)
            base = 2
            if pin is not None:
                draw_hdr(base, items[pin]); base += 1
            for k in range(body):
                idx = top + k
                if idx >= len(items): break
                it = items[idx]; y = base + k
                if it[0] == "gap":
                    continue
                if it[0] == "hdr":
                    draw_hdr(y, it); continue
                c = it[1]
                on = c["uuid"] in picked
                mark = PICK_ON if on else PICK_OFF
                ind = "  " if grouped else ""
                live = "  ● live" if c["live"] else ""
                if idx == cur:
                    pre = f" {ind}{mark} {c['rel']:>3} {human(c['size']):>6} {spark(c['size'])}  "
                    lbl = fit(c["label"], max(0, w - 1 - len(pre) - len(live)))
                    add(y, 0, (pre + lbl + live).ljust(w - 1), SEL)
                    continue
                add(y, 0, " " + ind); x = 1 + len(ind)
                add(y, x, mark, OK if on else DIM); x += 1
                seg = f" {c['rel']:>3} "
                add(y, x, seg, DIM); x += len(seg)
                szat = YEL if c["size"] >= (10 << 20) else DIM
                sz = f"{human(c['size']):>6} " + spark(c["size"])
                add(y, x, sz, szat); x += len(sz) + 2
                r = role(c["label"])
                tattr = curses.A_BOLD if c["live"] else DIM if r == "stale" else COL.get(r, 0)
                lbl = fit(c["label"], max(0, w - 1 - x - len(live)))
                p = lbl.lower().find(f) if flt else -1
                if p >= 0:                               # underline the filter match
                    add(y, x, lbl[:p], tattr)
                    add(y, x + p, lbl[p:p + len(f)], tattr | curses.A_BOLD | curses.A_UNDERLINE)
                    add(y, x + p + len(f), lbl[p + len(f):], tattr)
                else:
                    add(y, x, lbl, tattr)
                x += len(lbl)
                if c["live"]: add(y, x, "  ● live", OK)
            scrollbar(base, body, top, len(items))

            add(h - 2, 0, RULE * (w - 1), DIM)
            if filtering:
                add(h - 1, 1, "/", ACC | curses.A_BOLD)
                add(h - 1, 2, flt, curses.A_BOLD)
                add(h - 1, 2 + len(flt), "▏", DIM)
                mtxt = f"{len(vis)} match{'es' if len(vis) != 1 else ''} · enter keep · esc clear"
                add(h - 1, max(1, w - len(mtxt) - 2), mtxt, DIM)
            elif msg:
                add(h - 1, 1, msg[1], OK if msg[0] == "ok" else WARN)
            else:
                x = 1
                hints = [("?", "keys"), ("space", "pick"), ("p", "peek"), ("d", "delete"),
                         ("t", "trash"), ("/", "filter"), ("q", "quit")]
                if undo: hints.insert(4, ("u", "undo"))
                for key, act in hints:
                    add(h - 1, x, key, curses.A_BOLD); x += len(key) + 1
                    add(h - 1, x, act, DIM); x += len(act) + 3
                if picked:
                    ptxt = f"{PICK_ON} {len(picked)} picked · {human(psz)}"
                    add(h - 1, max(1, w - len(ptxt) - 2), ptxt, OK)
            stdscr.refresh()

            ch = stdscr.getch()
            msg = None
            if filtering:
                if ch in (10, 13): filtering = False
                elif ch == 27: filtering = False; flt = ""
                elif ch in (curses.KEY_BACKSPACE, 127, 8): flt = flt[:-1]
                elif 32 <= ch < 127: flt += chr(ch)
                cur = top = 0
                continue

            pos = ci.index(cur) if cur in ci else 0
            if ch in (ord("q"), 27): break
            elif ch == ord("?"): do_help()
            elif ci and ch in (curses.KEY_DOWN, ord("j")): cur = ci[min(pos + 1, len(ci) - 1)]
            elif ci and ch in (curses.KEY_UP, ord("k")): cur = ci[max(pos - 1, 0)]
            elif ci and ch == curses.KEY_NPAGE: cur = ci[min(pos + body, len(ci) - 1)]
            elif ci and ch == curses.KEY_PPAGE: cur = ci[max(pos - body, 0)]
            elif ci and ch == ord("g"): cur = ci[0]
            elif ci and ch == ord("G"): cur = ci[-1]
            elif ch == ord("s"):
                sort_mode = "size" if sort_mode == "recency" else "recency"
                cur = top = 0
            elif grouped and ch == ord("]"):
                hd = [i for i, it in enumerate(items) if it[0] == "hdr"]
                gh = max([i for i in hd if i <= cur], default=-1)
                nxt = [i for i in hd if i > gh]
                if nxt: cur = nxt[0] + 1
            elif grouped and ch == ord("["):
                hd = [i for i, it in enumerate(items) if it[0] == "hdr"]
                gh = max([i for i in hd if i <= cur], default=None)
                if gh is not None and cur > gh + 1: cur = gh + 1
                else:
                    prv = [i for i in hd if gh is not None and i < gh]
                    if prv: cur = prv[-1] + 1
            elif ch == ord("/"): filtering = True; flt = ""
            elif ch == ord("c"): picked.clear()
            elif ch == ord("a"):                         # toggle: all shown picked -> unpick them
                sable = [c["uuid"] for c in vis if not c["live"]]
                if sable and all(u in picked for u in sable):
                    for u in sable: picked.discard(u)
                else:
                    picked.update(sable)
            elif ch == ord("p"):
                if ci and items[cur][0] == "chat": do_peek(items[cur][1])
            elif ch == ord("t"):
                if do_trash():                           # something restored -> refresh list
                    chats = loader(); by = {c["uuid"]: c for c in chats}
                    undo = [d for d in undo if os.path.isdir(d)]
                    cur = top = 0
            elif ch == ord("u"):
                if not undo:
                    msg = ("warn", "nothing to undo")
                else:
                    m = restore_entry(undo.pop())
                    chats = loader(); by = {c["uuid"]: c for c in chats}
                    msg = (("ok", f"restored {fit(m.get('label') or '?', 40)}") if m
                           else ("warn", "could not restore"))
            elif ch == ord(" "):
                if ci and items[cur][0] == "chat":
                    c = items[cur][1]
                    if c["live"]: msg = ("warn", "can't pick a live session")
                    else: picked.discard(c["uuid"]) if c["uuid"] in picked else picked.add(c["uuid"])
                    cur = ci[min(pos + 1, len(ci) - 1)]
            elif ch in (ord("d"), 10, 13):
                if not picked:
                    msg = ("warn", "nothing selected"); continue
                sel = [by[u] for u in picked if u in by]
                if confirm_delete(sel):
                    for u in list(picked):
                        if u in by: undo.append(trash_chat(by[u]["dir"], u, by[u]["label"]))
                    chats = loader(); by = {c["uuid"]: c for c in chats}
                    n = len(sel)
                    picked = set()
                    msg = ("ok", f"trashed {n} chat{'s' if n != 1 else ''} · u undo · t trash")
                else:
                    msg = ("warn", "cancelled")

    curses.wrapper(main)

def print_help():
    on = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    def c(s, code): return f"\033[{code}m{s}\033[0m" if on else s
    B = lambda s: c(s, "1"); D = lambda s: c(s, "2")
    CMD = lambda s: c(s, "36"); HEAD = lambda s: c(s, "1;4")        # cyan / bold-underline

    print(f"{B('reap')} {D(': Claude Code chat manager')}")
    print(D("view, peek and delete your local Claude Code chats"))
    print()
    print(D("a chat = transcript + sidecar dir + agents-view job record;"))
    print(D("reap removes all three, so it's gone from /resume and the agents view."))
    print()
    print(HEAD("usage"))
    usage = [
        ("reap", "interactive picker: current project"),
        ("reap <name|path>", "picker for a project (name = folder substring)"),
        ("reap --all", "picker across all projects, grouped by workspace"),
        ("reap ls [<name>|--all]", "plain list (no UI; pipe-friendly)"),
        ("reap rm <id>... [opts]", "delete by uuid prefix (for scripts)"),
        ("reap trash [--empty]", "list recoverable deletes (or purge all)"),
        ("reap restore <id|name>", "restore a chat from the trash"),
        ("reap --help", "this help"),
        ("reap --version", "print version"),
    ]
    w = max(len(a) for a, _ in usage)
    for a, b in usage:
        print(f"  {CMD(a.ljust(w))}  {b}")
    print()
    print(f"  {D('rm options')}")
    for a, b in [("--apply", "actually delete (default is a dry-run)"),
                 ("--hard", "skip the trash: delete irreversibly"),
                 ("--orphans", "remove leftover sidecar dirs (no transcript)"),
                 ("-p <name>", "target another project (default: current dir)")]:
        print(f"    {CMD(a.ljust(11))}  {b}")
    print()
    print(HEAD("picker keys") + D("   (press ? inside the picker for these)"))
    for cat, keys in [("move", "up/down or j/k   PgUp/PgDn   g/G   [ ] prev/next workspace"),
                      ("select", "space pick   a toggle select-all   c clear"),
                      ("act", "p peek   d/enter delete (to trash)   u undo   t trash browser"),
                      ("view", "s sort recency<->size   / filter   q quit")]:
        print(f"  {CMD(cat.ljust(7))}  {keys}")
    print()
    print(D(f"deletes are confirmed first and reversible for {TRASH_DAYS} days; live sessions are protected."))

def pop_flag(lst, flag):
    if flag in lst: lst.remove(flag); return True
    return False

def pop_opt(lst, opt):
    if opt in lst:
        i = lst.index(opt)
        val = lst[i + 1] if i + 1 < len(lst) else None
        del lst[i:i + 2]
        return val
    return None

def cmd_ls(args):
    args = list(args)
    if pop_flag(args, "--all"):
        print_static(load_all(), grouped=True)
    else:
        proj = next((a for a in args if not a.startswith("-")), None)
        DIR = resolve_dir(proj)
        if not os.path.isdir(DIR): sys.exit(f"no chats found for: {DIR}")
        print_static(load_chats(DIR), grouped=False)

def cmd_rm(args):
    args = list(args)
    apply = pop_flag(args, "--apply")
    hard = pop_flag(args, "--hard")                      # skip trash, delete irreversibly
    orphans = pop_flag(args, "--orphans")
    proj = pop_opt(args, "-p")
    DIR = resolve_dir(proj)                              # None -> current project
    if not os.path.isdir(DIR): sys.exit(f"no chats found for: {DIR}")
    plan = []                                            # (uuid_or_None, path_or_None)
    if orphans:
        jsonls = {os.path.basename(p)[:-6] for p in glob.glob(os.path.join(DIR, "*.jsonl"))}
        for d in glob.glob(os.path.join(DIR, "*/")):
            b = os.path.basename(d.rstrip("/"))
            if b == "memory" or b in jsonls: continue
            plan.append((None, d.rstrip("/")))
    else:
        ids = [a for a in args if not a.startswith("-")]
        if not ids: sys.exit("usage: reap rm <id-prefix>... [--apply] [--orphans] [-p <project>]")
        live = live_session_ids()
        for tok in ids:
            hits = [os.path.basename(p)[:-6] for p in glob.glob(os.path.join(DIR, "*.jsonl"))
                    if os.path.basename(p).startswith(tok)]
            if not hits: print(f"!! no chat matches '{tok}'"); continue
            if len(hits) > 1: print(f"!! '{tok}' is ambiguous: {hits}"); continue
            jp = os.path.join(DIR, hits[0] + ".jsonl")
            fresh = os.path.exists(jp) and (time.time() - os.path.getmtime(jp)) < LIVE_FRESH
            if hits[0] in live or fresh:
                print(f"!! SKIP {hits[0]}: session is live"); continue
            plan.append((hits[0], None))
    if not plan:
        print("nothing to do"); return
    verb = "purge" if hard else "trash"
    for uuid, path in plan:
        what = f"orphan dir {os.path.basename(path)}" if path else f"{uuid} (transcript + sidecar + job)"
        print((verb.upper() + " " if apply else f"would {verb} ") + what)
    if apply:
        for uuid, path in plan:
            if path: shutil.rmtree(path, ignore_errors=True)     # orphan dirs: always hard
            elif hard: delete_chat(DIR, uuid)
            else: trash_chat(DIR, uuid)
        print("done." if hard else f"done, in trash for {TRASH_DAYS}d (reap restore to undo)")
    else:
        print(f"dry-run, add --apply to {verb}" + ("" if hard else " (--hard to skip trash)"))

def cmd_trash(args):
    args = list(args)
    if pop_flag(args, "--empty"):
        ents = trash_list()
        for e in ents: shutil.rmtree(e["_dir"], ignore_errors=True)
        print(f"emptied trash, purged {len(ents)} chats"); return
    ents = trash_list()
    if not ents: print("trash is empty"); return
    now = time.time()
    for e in ents:
        left = max(0, TRASH_DAYS - int((now - e.get("at", 0)) / 86400))
        print(f"  {reltime(e.get('at', 0), now):>4} {human(e['_size']):>6}  {e['uuid'][:8]}  "
              f"{left}d left  {(e.get('label') or '')[:48]}")
    print(f"\n{len(ents)} chats · {human(sum(e['_size'] for e in ents))} · restore: reap restore <id|name>")

def cmd_restore(args):
    ids = [a for a in args if not a.startswith("-")]
    ents = trash_list()
    if not ids:
        if not ents: print("trash is empty"); return
        print("usage: reap restore <id-prefix | name>...   in trash:")
        for e in ents: print(f"  {e['uuid'][:8]}  {(e.get('label') or '')[:50]}")
        return
    for tok in ids:
        hits = [e for e in ents if e["uuid"].startswith(tok)]
        if not hits:                                         # fall back to unique name substring
            hits = [e for e in ents if tok.lower() in (e.get("label") or "").lower()]
        if not hits: print(f"!! no trashed chat matches '{tok}'"); continue
        if len(hits) > 1: print(f"!! '{tok}' is ambiguous: {[e['uuid'][:8] for e in hits]}"); continue
        m = restore_entry(hits[0]["_dir"])
        print(f"restored {hits[0]['uuid'][:8]}  {(m.get('label') or '') if m else '(failed)'}")

def main():
    argv = sys.argv[1:]
    if "--version" in argv or "-V" in argv:
        print(f"reap {__version__}"); return
    if "-h" in argv or "--help" in argv:
        print_help(); return
    prune_trash()                                        # lazy retention, cheap, no daemon
    sub = argv[0] if argv and not argv[0].startswith("-") else None
    if sub == "ls": return cmd_ls(argv[1:])
    if sub == "rm": return cmd_rm(argv[1:])
    if sub == "trash": return cmd_trash(argv[1:])
    if sub == "restore": return cmd_restore(argv[1:])

    rest = list(argv)
    st = pop_flag(rest, "--selftest")
    if pop_flag(rest, "--all"):
        loader, title, grouped, where = load_all, "all projects", True, "all projects"
    else:
        proj = next((a for a in rest if not a.startswith("-")), None)
        DIR = resolve_dir(proj)
        if not os.path.isdir(DIR): sys.exit(f"no chats found for: {DIR}")
        title = os.getcwd() if proj is None else pretty(DIR)
        loader, grouped, where = (lambda d=DIR: load_chats(d)), False, title

    if st: selftest(loader(), where)
    elif not sys.stdout.isatty(): print_static(loader(), grouped)
    else: run_ui(loader, title, grouped)

if __name__ == "__main__":
    main()
